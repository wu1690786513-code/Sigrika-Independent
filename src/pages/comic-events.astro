---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { comicEvents, defaultComicPoster } from "@/config/comicEvents";
import type { ComicEvent } from "@/config/comicEvents";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

export type EventStatus = 'all' | 'future' | 'ongoing' | 'passed';

const now = new Date();

const getEventStatus = (event: ComicEvent): EventStatus => {
  const startDate = new Date(event.startDate);
  const endDate = event.endDate ? new Date(event.endDate) : new Date(event.startDate);
  endDate.setHours(23, 59, 59, 999);
  
  if (endDate < now) return 'passed';
  if (startDate > now) return 'future';
  return 'ongoing';
};

const allCities = [...new Set(comicEvents.map(e => e.city).filter(Boolean))];

const sortedEvents = [...comicEvents].sort((a, b) => {
  const aStart = new Date(a.startDate);
  const bStart = new Date(b.startDate);
  return aStart.getTime() - bStart.getTime();
});

const futureEvents = sortedEvents.filter(e => getEventStatus(e) === 'future');
const ongoingEvents = sortedEvents.filter(e => getEventStatus(e) === 'ongoing');
const passedEvents = [...sortedEvents].filter(e => getEventStatus(e) === 'passed').reverse();

const getPoster = (event: ComicEvent) => {
  if (event.poster && event.poster.trim() !== '') {
    return event.poster;
  }
  return defaultComicPoster;
};

const getPriceText = (event: ComicEvent) => {
  if (event.priceText) {
    return event.priceText;
  }
  if (event.preSalePrice && event.onSitePrice) {
    return `预售${event.preSalePrice}元 | 现场${event.onSitePrice}元`;
  }
  return null;
};

const getDatePart = (dateStr: string) => {
  if (!dateStr) return '';
  return dateStr.split(' ')[0];
};

const tabs = [
  { id: 'all', label: '全部', count: comicEvents.length },
  { id: 'future', label: '即将到来', count: futureEvents.length },
  { id: 'ongoing', label: '进行中', count: ongoingEvents.length },
  { id: 'passed', label: '已结束', count: passedEvents.length },
];

---

<MainGridLayout title="漫展日程" description="主包的漫展日程安排">

  <div class={`comic-events-page ${className || ''}`}>
    <div class="card-base rounded-(--radius-large) overflow-hidden p-6 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-8 w-8 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white dark:text-black/70">
          <Icon is:inline name="material-symbols:festival" class="text-[1.5rem]" />
        </div>
        <div>
          <h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">漫展日程</h1>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">记录主包参加的漫展活动</p>
        </div>
      </div>

      <comic-events-filter class="filter-tabs mb-6">
        <div class="tabs-container flex flex-wrap gap-2 mb-3">
          {tabs.map((tab) => (
            <button 
              key={tab.id} 
              class:list={[
                'tab-button btn-regular px-3 py-1.5 rounded-lg text-sm font-medium transition-colors duration-200',
                tab.id === 'all' 
                  ? 'bg-(--primary) text-white hover:bg-(--primary)' 
                  : 'bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover)'
              ]}
              data-tab={tab.id}
            >
              <span>{tab.label}</span>
              <span class="tab-count ml-2">{tab.count}</span>
            </button>
          ))}
        </div>
        
        {allCities.length > 0 && (
          <div class="city-filter flex flex-wrap gap-2">
            <button 
              class="city-tag btn-regular px-3 py-1.5 rounded-lg bg-(--primary) text-white hover:bg-(--primary) transition-colors duration-200 text-sm font-medium"
              data-city=""
            >
              全部城市
            </button>
            {allCities.map((city) => (
              <button 
                key={city}
                class="city-tag btn-regular px-3 py-1.5 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors duration-200 text-sm font-medium"
                data-city={city}
              >
                {city}
              </button>
            ))}
          </div>
        )}
      </comic-events-filter>

      <div id="events-container">
        <section class="event-section" data-status="ongoing" style={ongoingEvents.length === 0 ? 'display:none' : ''}>
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            正在进行中
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {ongoingEvents.map((event) => (
              <div class:list={['comic-card', 'event-card']} data-status="ongoing" data-city={event.city || ''}>
                {event.url ? (
                  <a href={event.url} target="_blank" rel="noopener noreferrer" class="block">
                    <div class="card-poster">
                      <img src={getPoster(event)} alt={event.name} loading="lazy" />
                      <span class="status-badge ongoing">进行中</span>
                    </div>
                    <div class="card-content">
                      <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                        <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                        <span>{event.name}</span>
                      </p>
                      <div class="card-info space-y-2 text-sm mt-2">
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                          <span class="truncate">{getDatePart(event.startDate)}{event.endDate ? ` ~ ${getDatePart(event.endDate)}` : ''}</span>
                        </div>
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                          <span class="truncate">{event.location}</span>
                        </div>
                        {event.goingDate && (
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">赴约：{getDatePart(event.goingDate)}</span>
                          </div>
                        )}
                        {getPriceText(event) && (
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                            <span class="price-label shrink-0" title={getPriceText(event)}>票价：{getPriceText(event)}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  </a>
                ) : (
                  <div>
                    <div class="card-poster">
                      <img src={getPoster(event)} alt={event.name} loading="lazy" />
                      <span class="status-badge ongoing">进行中</span>
                    </div>
                    <div class="card-content">
                      <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                        <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                        <span>{event.name}</span>
                      </p>
                      <div class="card-info space-y-2 text-sm mt-2">
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                          <span class="truncate">{getDatePart(event.startDate)}{event.endDate ? ` ~ ${getDatePart(event.endDate)}` : ''}</span>
                        </div>
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                          <span class="truncate">{event.location}</span>
                        </div>
                        {event.goingDate && (
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">赴约：{getDatePart(event.goingDate)}</span>
                          </div>
                        )}
                        {getPriceText(event) && (
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                            <span class="price-label shrink-0" title={getPriceText(event)}>票价：{getPriceText(event)}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        <section class="event-section" data-status="future" style={futureEvents.length === 0 ? 'display:none' : ''}>
          <div class="section-divider">
            <span class="divider-line"></span>
            <span class="divider-text">即将到来</span>
            <span class="divider-line"></span>
          </div>
          {futureEvents[0] && (
            <div class:list={['comic-card', 'comic-card-large', 'event-card']} data-status="future" data-city={futureEvents[0].city || ''}>
              {futureEvents[0].url ? (
                <a href={futureEvents[0].url} target="_blank" rel="noopener noreferrer" class="block">
                  <div class="card-poster">
                    <img src={getPoster(futureEvents[0])} alt={futureEvents[0].name} loading="lazy" />
                    <span class="status-badge future">即将开始</span>
                  </div>
                  <div class="card-content">
                    <div class="card-header">
                      <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                        <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                        <span>{futureEvents[0].name}</span>
                      </p>
                    </div>
                    <div class="card-info space-y-2 text-sm mt-2">
                      <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                        <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                        <span class="truncate">{getDatePart(futureEvents[0].startDate)}{futureEvents[0].endDate ? ` ~ ${getDatePart(futureEvents[0].endDate)}` : ''}</span>
                      </div>
                      <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                        <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                        <span class="truncate">{futureEvents[0].location}</span>
                      </div>
                      {futureEvents[0].goingDate && (
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                          <span class="truncate">赴约：{getDatePart(futureEvents[0].goingDate)}</span>
                        </div>
                      )}
                      {getPriceText(futureEvents[0]) && (
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                          <span class="price-text text-left flex-1 min-w-0" title={getPriceText(futureEvents[0])}>票价：{getPriceText(futureEvents[0])}</span>
                        </div>
                      )}
                    </div>
                  </div>
                </a>
              ) : (
                <div>
                  <div class="card-poster">
                    <img src={getPoster(futureEvents[0])} alt={futureEvents[0].name} loading="lazy" />
                    <span class="status-badge future">即将开始</span>
                  </div>
                  <div class="card-content">
                    <div class="card-header">
                      <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                        <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                        <span>{futureEvents[0].name}</span>
                      </p>
                    </div>
                    <div class="card-info space-y-2 text-sm mt-2">
                      <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                        <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                        <span class="truncate">{getDatePart(futureEvents[0].startDate)}{futureEvents[0].endDate ? ` ~ ${getDatePart(futureEvents[0].endDate)}` : ''}</span>
                      </div>
                      <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                        <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                        <span class="truncate">{futureEvents[0].location}</span>
                      </div>
                      {futureEvents[0].goingDate && (
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                          <span class="truncate">赴约：{getDatePart(futureEvents[0].goingDate)}</span>
                        </div>
                      )}
                      {getPriceText(futureEvents[0]) && (
                        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                          <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                          <span class="price-text text-left flex-1 min-w-0" title={getPriceText(futureEvents[0])}>票价：{getPriceText(futureEvents[0])}</span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              )}
            </div>
          )}
          {futureEvents.length > 1 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
              {futureEvents.slice(1).map((event) => (
                <div class:list={['comic-card', 'event-card']} data-status="future" data-city={event.city || ''}>
                  {event.url ? (
                    <a href={event.url} target="_blank" rel="noopener noreferrer" class="block">
                      <div class="card-poster">
                        <img src={getPoster(event)} alt={event.name} loading="lazy" />
                      </div>
                      <div class="card-content">
                        <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                          <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                          <span>{event.name}</span>
                        </p>
                        <div class="card-info space-y-2 text-sm mt-2">
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{getDatePart(event.startDate)}{event.endDate ? ` ~ ${getDatePart(event.endDate)}` : ''}</span>
                          </div>
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{event.location}</span>
                          </div>
                          {event.goingDate && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                              <span class="truncate">赴约：{getDatePart(event.goingDate)}</span>
                            </div>
                          )}
                          {getPriceText(event) && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                              <span class="price-text text-left flex-1 min-w-0" title={getPriceText(event)}>票价：{getPriceText(event)}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    </a>
                  ) : (
                    <div>
                      <div class="card-poster">
                        <img src={getPoster(event)} alt={event.name} loading="lazy" />
                      </div>
                      <div class="card-content">
                        <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                          <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                          <span>{event.name}</span>
                        </p>
                        <div class="card-info space-y-2 text-sm mt-2">
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{getDatePart(event.startDate)}{event.endDate ? ` ~ ${getDatePart(event.endDate)}` : ''}</span>
                          </div>
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{event.location}</span>
                          </div>
                          {event.goingDate && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                              <span class="truncate">赴约：{getDatePart(event.goingDate)}</span>
                            </div>
                          )}
                          {getPriceText(event) && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                              <span class="price-text text-left flex-1 min-w-0" title={getPriceText(event)}>票价：{getPriceText(event)}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </section>

        <section class="event-section" data-status="passed" style={passedEvents.length === 0 ? 'display:none' : ''}>
          <div class="section-divider">
            <span class="divider-line"></span>
            <span class="divider-text">完结撒花</span>
            <span class="divider-line"></span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {passedEvents.map((event) => {
              const targetStr = event.goingDate || event.startDate;
              const dateParts = targetStr.split(' ');
              const datePart = dateParts[0];
              const [year, month, day] = datePart.split('-').map(Number);
              const targetDate = new Date(year, month - 1, day);
              const diff = now.getTime() - targetDate.getTime();
              const passedDays = Math.floor(diff / (1000 * 60 * 60 * 24));
              const titleText = event.passedText ? event.passedText.replace('{days}', String(passedDays)) : `已经过去了 ${passedDays} 天`;
              
              return (
                <div class:list={['comic-card', 'event-card']} data-status="passed" data-city={event.city || ''} title={titleText}>
                  {event.url ? (
                    <a href={event.url} target="_blank" rel="noopener noreferrer" class="block">
                      <div class="card-poster">
                        <img src={getPoster(event)} alt={event.name} loading="lazy" />
                        <span class="status-badge passed">已结束</span>
                      </div>
                      <div class="card-content">
                        <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                          <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                          <span>{event.name}</span>
                        </p>
                        <div class="card-info space-y-2 text-sm mt-2">
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{getDatePart(event.startDate)}{event.endDate ? ` ~ ${getDatePart(event.endDate)}` : ''}</span>
                          </div>
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{event.location}</span>
                          </div>
                          {event.goingDate && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                              <span class="truncate">赴约：{getDatePart(event.goingDate)}</span>
                            </div>
                          )}
                          {getPriceText(event) && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                              <span class="price-text" title={getPriceText(event)}>票价：{getPriceText(event)}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    </a>
                  ) : (
                    <div>
                      <div class="card-poster">
                        <img src={getPoster(event)} alt={event.name} loading="lazy" />
                        <span class="status-badge passed">已结束</span>
                      </div>
                      <div class="card-content">
                        <p class="card-title text-base font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-2">
                          <Icon is:inline name="material-symbols:festival" class="info-icon text-[var(--primary)]" />
                          <span>{event.name}</span>
                        </p>
                        <div class="card-info space-y-2 text-sm mt-2">
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:calendar-month-outline-rounded" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{getDatePart(event.startDate)}{event.endDate ? ` ~ ${getDatePart(event.endDate)}` : ''}</span>
                          </div>
                          <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                            <Icon name="material-symbols:location-on" class="info-icon text-[var(--primary)]" />
                            <span class="truncate">{event.location}</span>
                          </div>
                          {event.goingDate && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="material-symbols:navigation-outline" class="info-icon text-[var(--primary)]" />
                              <span class="truncate">赴约：{getDatePart(event.goingDate)}</span>
                            </div>
                          )}
                          {getPriceText(event) && (
                            <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                              <Icon name="mdi:ticket-outline" class="info-icon shrink-0 text-[var(--primary)]" />
                              <span class="price-text" title={getPriceText(event)}>票价：{getPriceText(event)}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>

        <div id="empty-state" class="hidden text-center py-16">
          <p class="text-[var(--content-meta)]">暂无符合条件的漫展信息</p>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<script slot="head" is:inline>
  if (!customElements.get("comic-events-filter")) {
    class ComicEventsFilter extends HTMLElement {
      selectedTab = "all";
      selectedCity = "";

      constructor() {
        super();
      }

      connectedCallback() {
        this.addEventListener("click", this.handleClick);
      }

      disconnectedCallback() {
        this.removeEventListener("click", this.handleClick);
      }

      handleClick(e) {
        const target = e.target;
        const tabButton = target.closest(".tab-button");
        const cityButton = target.closest(".city-tag");

        if (tabButton) {
          this.selectedTab = tabButton.dataset.tab || "all";
          this.updateTabStyles();
          this.applyFilters();
        } else if (cityButton) {
          this.selectedCity = cityButton.dataset.city || "";
          this.updateCityStyles();
          this.applyFilters();
        }
      }

      updateTabStyles() {
        const tabs = this.querySelectorAll(".tab-button");
        tabs.forEach((tab) => {
          tab.classList.remove("bg-(--primary)", "text-white", "hover:bg-(--primary)");
          tab.classList.add("bg-(--btn-regular-bg)", "text-(--btn-content)", "hover:bg-(--btn-regular-bg-hover)");
          if (tab.dataset.tab === this.selectedTab) {
            tab.classList.remove("bg-(--btn-regular-bg)", "text-(--btn-content)", "hover:bg-(--btn-regular-bg-hover)");
            tab.classList.add("bg-(--primary)", "text-white", "hover:bg-(--primary)");
          }
        });
      }

      updateCityStyles() {
        const cities = this.querySelectorAll(".city-tag");
        cities.forEach((city) => {
          city.classList.remove("bg-(--primary)", "text-white", "hover:bg-(--primary)");
          city.classList.add("bg-(--btn-regular-bg)", "text-(--btn-content)", "hover:bg-(--btn-regular-bg-hover)");
          if (city.dataset.city === this.selectedCity) {
            city.classList.remove("bg-(--btn-regular-bg)", "text-(--btn-content)", "hover:bg-(--btn-regular-bg-hover)");
            city.classList.add("bg-(--primary)", "text-white", "hover:bg-(--primary)");
          }
        });
      }

      applyFilters() {
        const container = this.closest(".card-base");
        if (!container) return;

        const sections = container.querySelectorAll(".event-section");
        const emptyState = container.querySelector("#empty-state");
        let hasVisible = false;

        sections.forEach((section) => {
          const sectionStatus = section.dataset.status;
          const shouldShowSection = this.selectedTab === "all" || sectionStatus === this.selectedTab;

          if (!shouldShowSection) {
            section.style.display = "none";
            return;
          }

          const sectionCards = section.querySelectorAll(".event-card");
          let sectionHasVisible = false;

          sectionCards.forEach((card) => {
            const cardCity = card.dataset.city || "";
            const shouldShowCard = this.selectedCity === "" || cardCity === this.selectedCity;

            if (shouldShowCard) {
              card.style.display = "";
              sectionHasVisible = true;
              hasVisible = true;
            } else {
              card.style.display = "none";
            }
          });

          section.style.display = sectionHasVisible ? "" : "none";
        });

        if (emptyState) {
          emptyState.style.display = hasVisible ? "none" : "block";
        }
      }
    }
    customElements.define("comic-events-filter", ComicEventsFilter);
  }

  if (!customElements.get("comic-countdown")) {
    class ComicCountdown extends HTMLElement {
      intervalId = null;
      initialized = false;

      constructor() {
        super();
      }

      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
        }
      }

      startCountdown() {
        const targetStr = this.dataset.target;
        const onGoingText = this.dataset.ongoing || "主包正在逛展位";
        const passedText = this.dataset.passed || "";

        if (!targetStr) return;

        const dateParts = targetStr.split(" ");
        const datePart = dateParts[0];
        const timePart = dateParts[1] || "00:00:00";

        const [year, month, day] = datePart.split("-").map(Number);
        const [hour = 0, minute = 0, second = 0] = timePart.split(":").map(Number);

        const targetDate = new Date(year, month - 1, day, hour, minute, second);
        const targetTime = targetDate.getTime();

        const updateDisplay = () => {
          const now = new Date();
          const nowTime = now.getTime();
          const diff = targetTime - nowTime;

          const isToday = now.getFullYear() === year &&
            now.getMonth() === month - 1 &&
            now.getDate() === day;

          if (diff <= 0) {
            if (this.intervalId) {
              clearInterval(this.intervalId);
              this.intervalId = null;
            }
            const passedDays = Math.floor(Math.abs(diff) / (1000 * 60 * 60 * 24));
            const showOngoing = isToday && diff >= -1000 * 60 * 60 * 24;

            if (showOngoing) {
              this.innerHTML = `<span class="countdown-status-text" style="color: var(--primary);">${onGoingText}</span>`;
            } else if (passedText) {
              const text = passedText.replace("{days}", String(passedDays));
              this.innerHTML = `<span class="countdown-status-text" style="color: var(--content-meta);">${text}</span>`;
            } else {
              this.innerHTML = `<span class="countdown-status-text" style="color: var(--content-meta);">已经过去了 ${passedDays} 天</span>`;
            }
            return;
          }

          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((diff % (1000 * 60)) / 1000);

          this.innerHTML = `
            <span class="countdown-item"><span class="countdown-num">${days}</span><span class="countdown-label">天</span></span>
            <span class="countdown-sep">:</span>
            <span class="countdown-item"><span class="countdown-num">${String(hours).padStart(2, '0')}</span><span class="countdown-label">时</span></span>
            <span class="countdown-sep">:</span>
            <span class="countdown-item"><span class="countdown-num">${String(minutes).padStart(2, '0')}</span><span class="countdown-label">分</span></span>
            <span class="countdown-sep">:</span>
            <span class="countdown-item"><span class="countdown-num">${String(seconds).padStart(2, '0')}</span><span class="countdown-label">秒</span></span>
          `;
        };

        updateDisplay();
        this.intervalId = setInterval(updateDisplay, 1000);
      }
    }
    customElements.define("comic-countdown", ComicCountdown);
  }

