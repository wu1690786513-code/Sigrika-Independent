---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();

// 计算标签颜色深度 0~1：数量越多颜色越深
const maxCount = Math.max(...tags.map((t) => t.count), 1);
const minCount = Math.min(...tags.map((t) => t.count), 1);
const getDepth = (count: number) => {
	if (maxCount === minCount) return 0.5;
	return (count - minCount) / (maxCount - minCount);
};

// Top 10 标签排行
const topTags = [...tags].sort((a, b) => b.count - a.count).slice(0, 10);
const topMaxCount = topTags.length > 0 ? topTags[0].count : 1;
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="mb-6">
                <div class="flex items-center justify-between mb-0">
                    <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
                        {i18n(I18nKey.allTags)}
                    </div>
                    <span class="text-sm font-medium px-2.5 py-0.5 rounded-full
                                 bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.25_0.025_var(--hue))]
                                 text-neutral-500 dark:text-neutral-400">
                        {tags.length}
                    </span>
                </div>
            </div>
            <div class="tags-cloud flex flex-wrap gap-3">
                {tags.map((t) => (
                    <a href={getTagUrl(t.name)}
                       class="tag-item group inline-flex items-center gap-0 rounded-lg
                              overflow-hidden transition-all duration-200
                              hover:scale-105 hover:shadow-md"
                       style={`--tag-depth: ${getDepth(t.count)}`}
                    >
                        <span class="tag-name text-sm font-medium px-4 py-2">
                            <span class="opacity-50 mr-0.5">#</span>{t.name.trim()}
                        </span>
                        <span class="tag-count inline-flex items-center justify-center h-full px-3 py-2 text-xs font-bold
                                     border-l border-black/8 dark:border-white/10">
                            {t.count}
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </div>

    <!-- Top 10 标签排行 -->
    {topTags.length > 0 && (
        <div class="card-base px-8 py-6 mt-4">
            <h2 class="text-lg font-bold text-75 mb-4">
                Top 10
            </h2>
            <div class="flex flex-col gap-3">
                {topTags.map((t, i) => (
                    <a href={getTagUrl(t.name)}
                       class="flex items-center gap-3 group hover:bg-(--btn-card-bg-hover) rounded-lg px-3 py-2 -mx-3 transition-colors"
                    >
                        <span class="text-sm font-bold text-(--primary) w-5 text-right shrink-0">
                            {i + 1}
                        </span>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-50 truncate group-hover:text-(--primary) transition-colors">
                                    #{t.name.trim()}
                                </span>
                                <span class="text-xs text-(--primary) ml-2 shrink-0">
                                    {t.count} {i18n(I18nKey.postsCount)}
                                </span>
                            </div>
                            <div class="h-2 rounded-full bg-(--primary)/10 overflow-hidden">
                                <div
                                    class="h-full rounded-full bg-(--primary) transition-all duration-500"
                                    style={`width: ${(t.count / topMaxCount) * 100}%`}
                                />
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    )}
</MainGridLayout>

<style is:global>
/* 标签云：根据 --tag-depth (0~1) 用主题色渲染，数量越多颜色越深 */
.tags-cloud .tag-item {
    background: color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 10% + 3%), transparent);
    color: color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 40% + 50%), var(--btn-content));
    border: 1px solid color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 15% + 5%), transparent);
}
.tags-cloud .tag-item:hover {
    background: color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 18% + 8%), transparent);
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 30% + 15%), transparent);
}
.tags-cloud .tag-item .tag-count {
    background: color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 12% + 6%), transparent);
    color: color-mix(in srgb, var(--primary) calc(var(--tag-depth, 0) * 50% + 50%), var(--btn-content));
}
</style>
