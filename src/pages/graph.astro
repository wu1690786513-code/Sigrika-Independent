---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getPostUrlBySlug, removeFileExtension, getTagUrl } from "@utils/url-utils";

// ========== 1. 读取文章数据 ==========
const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// ========== 2. 收集标签 ==========
const tagMap = new Map<string, { count: number; postIds: string[] }>();
for (const post of allPosts) {
  for (const tag of (post.data.tags || [])) {
    if (!tagMap.has(tag)) tagMap.set(tag, { count: 0, postIds: [] });
    const t = tagMap.get(tag)!;
    t.count++;
    t.postIds.push(post.id);
  }
}

// 标签按出现次数排序
const sortedTags = Array.from(tagMap.entries()).sort((a, b) => b[1].count - a[1].count);
const counts = sortedTags.map(([_, v]) => v.count);
const maxCount = Math.max(...counts, 1);
const minCount = Math.min(...counts, 1);
const countRange = maxCount - minCount || 1;
const medianCount = counts[Math.floor(counts.length / 2)] || 1;

const tagNodes = sortedTags.map(([name, info]) => {
  const normalized = (info.count - minCount) / countRange;
  const radius = 5 + normalized * 14; // 5~19px
  return {
    id: name,
    name,
    count: info.count,
    url: getTagUrl(name),
    radius: Math.round(radius * 10) / 10,
    isHighFreq: info.count >= medianCount,
    postIds: info.postIds,
  };
});

// ========== 3. 计算标签间关联（共享文章数）并裁剪弱关联 ==========
const tagPostSets = new Map<string, Set<string>>();
for (const t of tagNodes) {
  tagPostSets.set(t.id, new Set(t.postIds));
}

const rawLinks: { source: string; target: string; strength: number }[] = [];
for (let i = 0; i < tagNodes.length; i++) {
  for (let j = i + 1; j < tagNodes.length; j++) {
    const a = tagNodes[i].id;
    const b = tagNodes[j].id;
    const setA = tagPostSets.get(a)!;
    const setB = tagPostSets.get(b)!;
    let shared = 0;
    for (const pid of setA) if (setB.has(pid)) shared++;
    if (shared >= 2) { // 裁剪：只保留共享>=2篇的关联
      rawLinks.push({ source: a, target: b, strength: shared });
    }
  }
}

// ========== 4. 文章数据（用于标签详情视图） ==========
const postNodes = allPosts.map(post => ({
  id: post.id,
  title: post.data.title,
  url: getPostUrlBySlug(removeFileExtension(post.id)),
  published: post.data.published?.toISOString?.() || String(post.data.published),
  description: post.data.description || "",
  category: post.data.category || "未分类",
  tags: post.data.tags || [],
}));

// ========== 5. 序列化数据 ==========
const graphData = {
  tags: tagNodes.map(t => ({
    id: t.id,
    name: t.name,
    count: t.count,
    url: t.url,
    radius: t.radius,
    isHighFreq: t.isHighFreq,
  })),
  tagLinks: rawLinks.map(l => ({
    source: l.source,
    target: l.target,
    strength: l.strength,
  })),
  posts: postNodes.map(p => ({
    id: p.id,
    title: p.title,
    url: p.url,
    published: p.published,
    description: p.description,
    category: p.category,
    tags: p.tags,
    isPost: true,
  })),
  stats: {
    totalPosts: allPosts.length,
    totalTags: tagNodes.length,
    totalLinks: rawLinks.length,
  },
};
---

<MainGridLayout title="关系图谱(青春版)" description="探索标签关联，发现知识脉络">
  <Fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js" is:inline></script>
  </Fragment>

  <div class="obsidian-graph" id="obsidianGraph">
    <!-- 顶部工具栏 -->
    <div class="graph-toolbar card-base">
      <div class="toolbar-left">
        <h1 class="graph-title" id="graphTitle">知识星球</h1>
        <span class="graph-stats" id="graphStats">{graphData.stats.totalPosts} 篇文章 · {graphData.stats.totalTags} 个标签 · {graphData.stats.totalLinks} 条关联</span>
      </div>
      <div class="toolbar-right">
        <button class="back-btn hidden" id="backBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          <span>返回总览</span>
        </button>
        <div class="search-box">
          <input type="text" class="search-input" id="graphSearch" placeholder="搜索标签..." autocomplete="off"/>
          <button class="search-btn" id="graphSearchBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
        <button class="reset-btn" id="graphReset" title="重置视图">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
      </div>
    </div>

    <!-- 图谱画布 -->
    <div class="graph-canvas-wrapper card-base" id="graphWrapper">
      <svg id="graphSvg" width="100%" height="100%">
        <defs>
          <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="4" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <g id="graphViewport">
          <circle id="graphBoundary" class="graph-boundary" fill="none" stroke="rgba(214, 69, 58, 0.3)" stroke-width="1.5" stroke-dasharray="6 8"/>
          <g id="graphLinks"></g>
          <g id="graphNodes"></g>
          <g id="graphLabels"></g>
        </g>
      </svg>

      <!-- 悬浮提示 -->
      <div id="graphTooltip" class="graph-tooltip hidden">
        <div class="tooltip-card">
          <!-- 头部装饰 -->
          <div class="tooltip-header">
            <div class="tooltip-name" id="tooltipName"></div>
            <div class="tooltip-stats" id="tooltipStats"></div>
          </div>
          
          <!-- 内容区域 -->
          <div class="tooltip-content">
            <div class="tooltip-section">
              <div class="section-title tag-only">
                <span class="section-icon">📄</span>
                <span>最近几篇</span>
              </div>
              <div class="tooltip-posts" id="tooltipPosts"></div>
            </div>
            
            <!-- 标签区域 -->
            <div class="tooltip-tags" id="tooltipTags"></div>
          </div>
          
          <!-- 底部操作 -->
          <div class="tooltip-footer">
            <div class="tooltip-hint" id="tooltipHint"></div>
          </div>
        </div>
      </div>

      <!-- 缩放指示器 -->
      <div class="zoom-badge" id="zoomBadge">100%</div>
    </div>
  </div>
</MainGridLayout>

<script is:inline define:vars={{ graphData }}>
(function() {
  if (window.__obsidianGraphCleanup) {
    window.__obsidianGraphCleanup();
    window.__obsidianGraphCleanup = null;
  }

  const RAW = graphData;
  const wrapper = document.getElementById("graphWrapper");
  const container = document.getElementById("obsidianGraph");
  if (!wrapper || !window.d3) return;

  const d3 = window.d3;
  const svg = d3.select("#graphSvg");
  const viewport = d3.select("#graphViewport");
  const tooltip = document.getElementById("graphTooltip");
  const tooltipName = document.getElementById("tooltipName");
  const tooltipStats = document.getElementById("tooltipStats");
  const tooltipPosts = document.getElementById("tooltipPosts");
  const tooltipTags = document.getElementById("tooltipTags");
  const tooltipHint = document.getElementById("tooltipHint");
  let tooltipCurrentNode = null;
  let tooltipCurrentPage = 1;
  let isTooltipHovered = false;
  const zoomBadge = document.getElementById("zoomBadge");
  const backBtn = document.getElementById("backBtn");
  const graphTitle = document.getElementById("graphTitle");
  const graphStats = document.getElementById("graphStats");

  // ========== 尺寸 & 边界 ==========
  let width = wrapper.clientWidth || 800;
  let height = wrapper.clientHeight || 500;
  let cx = width / 2;
  let cy = height / 2;
  let boundaryR = Math.min(width, height) * 0.72;

  const isMobile = window.innerWidth < 768;

  // ========== 状态 ==========
  let currentView = 'tags'; // 'tags' | 'posts'
  let activeTag = null;
  let currentZoom = d3.zoomIdentity;
  let simulation = null;
  let tickCount = 0;
  let postDragTicks = 0;
  let idleTimer = null;
  let resizeTimer = null;
  let isVisible = false;
  let hasInitialized = false;

  // ========== 数据准备 ==========
  // 移动端过滤低频标签
  const visibleTagIds = new Set(
    isMobile ? RAW.tags.filter(t => t.count >= 3).map(t => t.id) : RAW.tags.map(t => t.id)
  );

  const allTagNodes = RAW.tags.map(d => ({ ...d, x: cx + (Math.random() - 0.5) * boundaryR * 0.9, y: cy + (Math.random() - 0.5) * boundaryR * 0.9 }));
  const allTagLinks = RAW.tagLinks.filter(l => visibleTagIds.has(l.source) && visibleTagIds.has(l.target));

  // 移除闲置检测，让模拟持续运行
  function resetIdleTimer() {} // 空函数，保持兼容

  // ========== 初始化边界圆环 ==========
  function updateBoundary() {
    d3.select("#graphBoundary")
      .attr("cx", cx)
      .attr("cy", cy)
      .attr("r", boundaryR);
  }
  updateBoundary();

  // ========== 缩放行为 ==========
  const zoomBehavior = d3.zoom()
    .scaleExtent([0.35, 3])
    .on("zoom", (event) => {
      currentZoom = event.transform;
      viewport.attr("transform", event.transform);
      zoomBadge.textContent = Math.round(event.transform.k * 100) + "%";
      // 根据缩放级别显示/隐藏标签
      const showLabels = event.transform.k >= 1.05;
      d3.selectAll(".graph-label").classed("is-visible", showLabels);
    });

  svg.call(zoomBehavior).on("dblclick.zoom", null);

  function resetZoom() {
    const s = Math.min(width / 900, height / 600, 1) * 0.92;
    svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity.translate((width - 900 * s) / 2, (height - 600 * s) / 2).scale(s));
  }

  // ========== 力导向模拟 ==========
  function createSimulation(nodes, links) {
    if (simulation) simulation.stop();
    tickCount = 0;

    const sim = d3.forceSimulation(nodes)
      .force("link", d3.forceLink(links).id(d => d.id).distance(d => {
        // 关联越强距离越近
        const base = currentView === 'tags' ? 100 : 80;
        return base / Math.sqrt((d.strength || 1) + 0.3);
      }).strength(d => {
        return currentView === 'tags'
          ? Math.min(0.5, (d.strength || 1) * 0.12)
          : 0.4;
      }))
      .force("charge", d3.forceManyBody().strength(d => {
        // 标签节点斥力大，文章节点斥力小
        return d.isPost ? -120 : -220;
      }).distanceMax(280))
      .force("center", d3.forceCenter(cx, cy).strength(0.035))
      .force("collision", d3.forceCollide().radius(d => (d.radius || 6) + 5).strength(0.6))
      .force("boundary", () => {
        for (const node of nodes) {
          const dx = node.x - cx;
          const dy = node.y - cy;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const limit = boundaryR - (node.radius || 6) - 12;
          if (dist > limit) {
            const angle = Math.atan2(dy, dx);
            node.x = cx + Math.cos(angle) * limit;
            node.y = cy + Math.sin(angle) * limit;
          }
        }
      })
      .alpha(1)
      .alphaDecay(0.035)
      .velocityDecay(0.4)
      .stop(); // 先停止，等待渲染后启动

    return sim;
  }

  // ========== 渲染函数 ==========
  function renderGraph(nodes, links) {
    const linkG = d3.select("#graphLinks");
    const nodeG = d3.select("#graphNodes");
    const labelG = d3.select("#graphLabels");

    // 清空旧内容
    linkG.selectAll("*").remove();
    nodeG.selectAll("*").remove();
    labelG.selectAll("*").remove();

    // --- 连线 ---
    const linkSel = linkG.selectAll("line")
      .data(links)
      .join("line")
      .attr("class", d => `graph-link l-${escClass(d.source.id || d.source)}-${escClass(d.target.id || d.target)}`)
      .attr("stroke", "rgba(214, 69, 58, 0.35)")
      .attr("stroke-width", d => Math.max(0.6, Math.min(2.5, (d.strength || 1) * 0.5)))
      .attr("stroke-linecap", "round");

    // --- 节点 ---
    const nodeSel = nodeG.selectAll("circle")
      .data(nodes)
      .join("circle")
      .attr("class", d => `graph-node n-${escClass(d.id)} ${d.isPost ? 'is-post' : ''} ${d.isHighFreq ? 'is-high' : 'is-low'}`)
      .attr("r", d => d.radius || 6)
      .attr("fill", "rgb(214, 69, 58)")
      .attr("stroke", "rgb(180, 55, 45)")
      .attr("stroke-width", 1.5)
      .attr("cursor", "pointer")
      .call(d3.drag()
        .on("start", dragstarted)
        .on("drag", dragged)
        .on("end", dragended));

    // --- 标签 ---
    const labelSel = labelG.selectAll("text")
      .data(nodes)
      .join("text")
      .attr("class", d => `graph-label n-${escClass(d.id)} ${d.isPost ? 'is-post' : ''}`)
      .attr("text-anchor", "middle")
      .attr("dy", d => -(d.radius || 6) - 5)
      .attr("font-size", d => d.isPost ? 9 : Math.max(10, Math.min(13, 9 + (d.radius || 6) * 0.25)))
      .attr("font-weight", d => d.isHighFreq ? "600" : "400")
      .attr("fill", "rgb(80, 50, 30)")
      .text(d => d.name);

    // 绑定交互
    nodeSel
      .on("mouseenter", function(event, d) {
        const nid = d.id;
        container.classList.add("highlight-mode");
        d3.select(this).classed("is-hovered", true);

        // 标记关联的连线和节点
        const connectedIds = new Set();
        links.forEach(l => {
          const sid = l.source.id || l.source;
          const tid = l.target.id || l.target;
          if (sid === nid || tid === nid) {
            connectedIds.add(sid === nid ? tid : sid);
            d3.select(`.l-${escClass(sid)}-${escClass(tid)}`).classed("is-connected", true);
            d3.select(`.l-${escClass(tid)}-${escClass(sid)}`).classed("is-connected", true);
          }
        });

        d3.selectAll(".graph-node").each(function(n) {
          if (n.id === nid) return;
          d3.select(this).classed("is-connected", connectedIds.has(n.id));
        });

        d3.selectAll(".graph-label").each(function(n) {
          if (n.id === nid) d3.select(this).classed("is-visible", true);
          else d3.select(this).classed("is-visible", connectedIds.has(n.id));
        });

        showTooltip(event, d);
      })
      .on("mouseleave", function(event, d) {
        container.classList.remove("highlight-mode");
        d3.select(this).classed("is-hovered", false);
        d3.selectAll(".graph-link").classed("is-connected", false);
        d3.selectAll(".graph-node").classed("is-connected", false);
        d3.selectAll(".graph-label").classed("is-visible", currentZoom.k >= 1.05);
        hideTooltip();
      })
      .on("click", function(event, d) {
        event.stopPropagation();
        if (d.isPost && d.url) {
          window.open(d.url, "_blank");
        } else if (!d.isPost) {
          // 点击标签 → 切换到文章-标签视图
          switchToPostView(d);
        }
      });

    return { linkSel, nodeSel, labelSel };
  }

  function escClass(s) {
    return String(s).replace(/[^a-zA-Z0-9\u4e00-\u9fa5]/g, '_');
  }

  // ========== 视图切换：标签总览 ==========
  function switchToTagView() {
    currentView = 'tags';
    activeTag = null;
    backBtn.classList.add("hidden");
    graphTitle.textContent = "知识星球";
    graphStats.textContent = `${RAW.stats.totalPosts} 篇文章 · ${RAW.stats.totalTags} 个标签 · ${RAW.stats.totalLinks} 条关联`;

    // 显示所有标签节点，不移除任何节点
    const nodes = allTagNodes.map(n => ({ ...n }));
    const links = allTagLinks.map(l => ({ ...l }));

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    // 启动模拟，持续运行
    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    resetZoom();
    resetIdleTimer();
  }

  // ========== 视图切换：文章-标签详情 ==========
  function switchToPostView(tagNode) {
    currentView = 'posts';
    activeTag = tagNode.id;
    backBtn.classList.remove("hidden");
    graphTitle.textContent = `「${tagNode.name}」关联图谱`;

    // 找到包含该标签的文章
    const relatedPosts = RAW.posts.filter(p => p.tags.includes(tagNode.id));
    graphStats.textContent = `${relatedPosts.length} 篇关联文章`;

    // 中心标签节点
    const centerNode = {
      ...tagNode,
      x: cx,
      y: cy,
      radius: 22,
      isHighFreq: true,
    };

    // 文章节点：围绕中心分布
    const postNodes = relatedPosts.map((p, i) => ({
      id: p.id,
      name: p.title,
      url: p.url,
      isPost: true,
      radius: 5,
      x: cx + (Math.random() - 0.5) * boundaryR * 0.9,
      y: cy + (Math.random() - 0.5) * boundaryR * 0.9,
      published: p.published,
      description: p.description,
      category: p.category,
    }));

    // 文章-标签连线
    const postLinks = postNodes.map(p => ({
      source: p.id,
      target: tagNode.id,
      strength: 1,
    }));

    const nodes = [centerNode, ...postNodes];
    const links = postLinks;

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    tickCount = 0;
    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    resetZoom();
    resetIdleTimer();
  }

  // ========== 拖拽节点 ==========
  function dragstarted(event, d) {
    if (!event.active) {
      simulation.alphaTarget(0.25).restart();
    }
    d.fx = d.x;
    d.fy = d.y;
    d3.select(this).classed("is-dragging", true);
    postDragTicks = 0;
    simulation.on("tick.postdrag", null);
  }

  function dragged(event, d) {
    d.fx = event.x;
    d.fy = event.y;
    const dx = event.x - cx;
    const dy = event.y - cy;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const limit = boundaryR - (d.radius || 6) - 12;
    if (dist > limit) {
      const angle = Math.atan2(dy, dx);
      d.fx = cx + Math.cos(angle) * limit;
      d.fy = cy + Math.sin(angle) * limit;
    }
  }

  function dragended(event, d) {
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null;
    d.fy = null;
    d3.select(this).classed("is-dragging", false);

    // 拖拽结束后继续运行，不停止模拟
  }

  // ========== Tooltip ==========
  function showTooltip(event, d) {
    tooltipCurrentNode = d;
    tooltipCurrentPage = 1;
    tooltipName.textContent = d.title || d.name;  // 文章用title，标签用name
    
    if (d.isPost) {
      tooltip.classList.add("is-post-tooltip");
      // 文章详情
      tooltipStats.innerHTML = d.category ? `<span class="stat-item">${d.category}</span>` : '';
      
      if (d.published) {
        const date = new Date(d.published);
        const dateStr = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        tooltipStats.innerHTML += `<span class="stat-divider">·</span><span class="stat-item">${dateStr}</span>`;
      }
      
      // 文章列表区域显示描述
      tooltipPosts.innerHTML = `<div class="post-description">${d.description || '暂无描述'}</div>`;
      
      // 获取文章的标签
      const postTags = d.tags || [];
      if (postTags.length > 0) {
        tooltipTags.innerHTML = `<div class="tags-label">标签</div><div class="tags-list">` + postTags.slice(0, 6).map(t => `<span class="tag-item">${t}</span>`).join('') + `</div>`;
      } else {
        tooltipTags.innerHTML = '';
      }
      
      tooltipHint.innerHTML = '<a href="' + d.url + '" target="_blank" class="hint-link"><span class="hint-icon">→</span>点击查看文章</a>';
    } else {
      tooltip.classList.remove("is-post-tooltip");
      // 标签详情
      tooltipStats.innerHTML = `<span class="stat-item">${d.count} 篇文章</span>`;
      tooltipTags.innerHTML = '';
      
      // 获取所有关联文章，按发布时间排序
      const relatedPosts = RAW.posts
        .filter(p => p.tags.includes(d.id))
        .sort((a, b) => new Date(b.published || 0) - new Date(a.published || 0));
      
      const pageSize = 5;
      const totalPages = Math.ceil(relatedPosts.length / pageSize);
      const displayPosts = relatedPosts.slice((tooltipCurrentPage - 1) * pageSize, tooltipCurrentPage * pageSize);
      
      // 渲染文章列表
      if (relatedPosts.length > 0) {
        tooltipPosts.innerHTML = '';
        displayPosts.forEach((post, index) => {
          tooltipPosts.innerHTML += `
            <div class="post-item">
              <span class="post-number">${(tooltipCurrentPage - 1) * pageSize + index + 1}.</span>
              <a href="${post.url}" target="_blank" class="post-title">${post.title}</a>
            </div>
          `;
        });
        
        // 添加翻页按钮
        if (totalPages > 1) {
          tooltipPosts.innerHTML += `
            <div class="tooltip-pagination">
              <span class="pagination-btn prev" ${tooltipCurrentPage <= 1 ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipPrevPage()">‹</span>
              <span class="pagination-info">${tooltipCurrentPage}/${totalPages}</span>
              <span class="pagination-btn next" ${tooltipCurrentPage >= totalPages ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipNextPage()">›</span>
            </div>
          `;
        }
      } else {
        tooltipPosts.innerHTML = '<div class="empty-state">暂无关联文章</div>';
      }
      
      tooltipHint.innerHTML = '<span class="hint-link" onclick="switchToTagDetailView(\'' + d.id + '\')"><span class="hint-icon">→</span>点击查看所有关联文章</span>';
    }
    
    tooltip.classList.remove("hidden");

    const rect = wrapper.getBoundingClientRect();
    let x = event.clientX - rect.left + 12;
    let y = event.clientY - rect.top - 8;
    const ttRect = tooltip.getBoundingClientRect();
    if (x + ttRect.width > rect.width) x = event.clientX - rect.left - ttRect.width - 12;
    if (y + ttRect.height > rect.height) y = event.clientY - rect.top - ttRect.height - 8;
    if (y < 0) y = 8;
    tooltip.style.left = x + "px";
    tooltip.style.top = y + "px";
  }

  function tooltipPrevPage() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    if (tooltipCurrentPage > 1) {
      tooltipCurrentPage--;
      updateTooltipPosts();
    }
  }

  function tooltipNextPage() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    const relatedPosts = RAW.posts.filter(p => p.tags.includes(tooltipCurrentNode.id));
    const totalPages = Math.ceil(relatedPosts.length / 5);
    if (tooltipCurrentPage < totalPages) {
      tooltipCurrentPage++;
      updateTooltipPosts();
    }
  }

  function updateTooltipPosts() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    
    const relatedPosts = RAW.posts
      .filter(p => p.tags.includes(tooltipCurrentNode.id))
      .sort((a, b) => new Date(b.published || 0) - new Date(a.published || 0));
    
    const pageSize = 5;
    const totalPages = Math.ceil(relatedPosts.length / pageSize);
    const displayPosts = relatedPosts.slice((tooltipCurrentPage - 1) * pageSize, tooltipCurrentPage * pageSize);
    
    tooltipPosts.style.opacity = '0';
    setTimeout(() => {
      tooltipPosts.innerHTML = '';
      displayPosts.forEach((post, index) => {
        tooltipPosts.innerHTML += `
          <div class="post-item">
            <span class="post-number">${(tooltipCurrentPage - 1) * pageSize + index + 1}</span>
            <a href="${post.url}" target="_blank" class="post-title">${post.title}</a>
          </div>
        `;
      });
      
      // 更新页码
      if (totalPages > 1) {
        tooltipPosts.innerHTML += `
          <div class="tooltip-pagination">
            <span class="pagination-btn prev" ${tooltipCurrentPage <= 1 ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipPrevPage()">‹</span>
            <span class="pagination-info">${tooltipCurrentPage}/${totalPages}</span>
            <span class="pagination-btn next" ${tooltipCurrentPage >= totalPages ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipNextPage()">›</span>
          </div>
        `;
      }
      
      tooltipPosts.style.opacity = '1';
    }, 100);
  }

  window.tooltipPrevPage = tooltipPrevPage;
  window.tooltipNextPage = tooltipNextPage;

  // 点击按钮切换到标签详情视图
  function switchToTagDetailView(tagId) {
    tooltip.classList.add("hidden");
    const tagNode = allTagNodes.find(t => t.id === tagId);
    if (tagNode) {
      switchToPostView(tagNode);
    }
  }

  window.switchToTagDetailView = switchToTagDetailView;

  function hideTooltip() {
    // 添加延迟，确保tooltip的mouseenter事件先触发
    setTimeout(() => {
      if (!isTooltipHovered) {
        tooltip.classList.add("hidden");
        tooltipCurrentNode = null;
      }
    }, 100);
  }

  // Tooltip鼠标事件
  tooltip.addEventListener("mouseenter", () => {
    isTooltipHovered = true;
  });

  tooltip.addEventListener("mouseleave", () => {
    isTooltipHovered = false;
    // 鼠标离开tooltip后立即关闭
    tooltip.classList.add("hidden");
    tooltipCurrentNode = null;
    tooltipCurrentPage = 1;
  });

  // ========== 搜索 ==========
  const searchInput = document.getElementById("graphSearch");
  const searchBtn = document.getElementById("graphSearchBtn");

  function doSearch() {
    const kw = searchInput.value.trim().toLowerCase();
    if (!kw) {
      d3.selectAll(".graph-node").classed("is-dimmed", false);
      d3.selectAll(".graph-link").classed("is-dimmed", false);
      d3.selectAll(".graph-label").classed("is-dimmed", false);
      return;
    }
    d3.selectAll(".graph-node").classed("is-dimmed", d => !d.name.toLowerCase().includes(kw));
    d3.selectAll(".graph-label").classed("is-dimmed", d => !d.name.toLowerCase().includes(kw));
    d3.selectAll(".graph-link").classed("is-dimmed", true);
  }

  let searchDebounce;
  searchInput.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(doSearch, 250);
  });
  searchBtn.addEventListener("click", doSearch);
  searchInput.addEventListener("keydown", e => { if (e.key === "Enter") doSearch(); });

  // ========== 返回总览 ==========
  backBtn.addEventListener("click", () => {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false);
    switchToTagView();
  });

  // ========== 重置视图 ==========
  document.getElementById("graphReset").addEventListener("click", () => {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false);
    if (currentView === 'posts' && activeTag) {
      const tag = allTagNodes.find(t => t.id === activeTag);
      if (tag) switchToPostView(tag);
    } else {
      switchToTagView();
    }
  });

  // ========== resize 防抖 ==========
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      width = wrapper.clientWidth || 800;
      height = wrapper.clientHeight || 500;
      cx = width / 2;
      cy = height / 2;
      boundaryR = Math.min(width, height) * 0.72;
      updateBoundary();
      if (simulation) {
        simulation.force("center", d3.forceCenter(cx, cy).strength(0.035));
        simulation.alpha(0.3).restart();
      }
    }, 150);
  });

  // ========== IntersectionObserver 懒加载 ==========
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !hasInitialized) {
        hasInitialized = true;
        switchToTagView();
        observer.disconnect();
      }
    });
  }, { threshold: 0.1 });
  observer.observe(wrapper);

  // ========== 清理函数 ==========
  window.__obsidianGraphCleanup = function() {
    if (simulation) simulation.stop();
    svg.on(".zoom", null);
    clearTimeout(idleTimer);
    clearTimeout(resizeTimer);
    observer.disconnect();
    hasInitialized = false;
  };
})();
</script>

