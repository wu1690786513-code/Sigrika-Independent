  // ========== 视图切换：全部文章 ==========
  function switchToAllPostsView() {
    currentView = 'posts';
    activeTag = null;
    activeCategory = null;
    backBtn.classList.add("hidden");
    document.getElementById("tabBar").classList.remove("hidden");
    graphTitle.textContent = "次元星球";
    graphStats.textContent = `${RAW.stats.totalPosts} 篇文章`;

    // 按发布时间排序，最近的文章在中心附近
    const sortedPosts = [...RAW.posts].sort((a, b) => 
      new Date(b.published || 0) - new Date(a.published || 0)
    );

    // 文章节点：从中心向外分布，最近的在中心
    const postNodes = sortedPosts.map((p, i) => {
      // 最近的文章从中心开始，逐渐向外扩散
      const angle = (i / sortedPosts.length) * Math.PI * 2;
      const radiusFactor = Math.sqrt(i / sortedPosts.length);
      const r = radiusFactor * boundaryR * 0.8;
      return {
        id: p.id,
        name: p.title,
        title: p.title,
        url: p.url,
        isPost: true,
        radius: Math.max(4, 7 - i * 0.02), // 越近的文章越大
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
        published: p.published,
        description: p.description,
        category: p.category,
        tags: p.tags,
      };
    });

    // 全部文章视图不显示连线
    const nodes = postNodes;
    const links = [];

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    tickCount = 0;
    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    resetZoom();
    resetIdleTimer();
  }

  // ========== 视图切换：随机漫步 ==========
  function switchToRandomView() {
    currentView = 'random';
    activeTag = null;
    activeCategory = null;
    backBtn.classList.add("hidden");
    document.getElementById("tabBar").classList.remove("hidden");
    graphTitle.textContent = "随机漫步";
    graphStats.textContent = "会邂逅哪段记忆呢";

    // 随机挑选10篇文章
    const shuffled = [...RAW.posts].sort(() => Math.random() - 0.5);
    const randomPosts = shuffled.slice(0, Math.min(10, RAW.posts.length));

    // 文章节点：球体放大显示
    const postNodes = randomPosts.map((p, i) => {
      const angle = (i / randomPosts.length) * Math.PI * 2;
      const radiusFactor = Math.sqrt(Math.random());
      const r = radiusFactor * boundaryR * 0.6; // 适当放大，更分散
      return {
        id: p.id,
        name: p.title,
        title: p.title,
        url: p.url,
        isPost: true,
        radius: 8 + Math.random() * 4, // 适当放大
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
        published: p.published,
        description: p.description,
        category: p.category,
        tags: p.tags,
      };
    });

    // 文章之间的关联
    const postLinks = [];
    for (let i = 0; i < postNodes.length; i++) {
      for (let j = i + 1; j < postNodes.length; j++) {
        const a = postNodes[i];
        const b = postNodes[j];
        const sharedTags = (a.tags || []).filter(t => (b.tags || []).includes(t)).length;
        if (sharedTags >= 1) {
          postLinks.push({
            source: a.id,
            target: b.id,
            strength: sharedTags,
          });
        }
      }
    }

    const nodes = postNodes;
    const links = postLinks;

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    tickCount = 0;
    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    // 随机漫步模式适当放大显示
    const mobileScale = 0.8;
    const desktopScale = Math.min(width / 800, height / 500, 1) * 0.95;
    const s = isMobile ? mobileScale : desktopScale;
    const tx = width / 2 * (1 - s);
    const ty = height / 2 * (1 - s);
    svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity.translate(tx, ty).scale(s));
    resetIdleTimer();
  }

  // ========== 拖拽节点 ==========
  function dragstarted(event, d) {
    if (!event.active) {
      simulation.alphaTarget(0.25).restart();
    }
    d.fx = d.x;
    d.fy = d.y;
    d3.select(this).classed("is-dragging", true);
    postDragTicks = 0;
    simulation.on("tick.postdrag", null);
    isDragging = true;  // 设置拖拽状态
  }

  function dragged(event, d) {
    d.fx = event.x;
    d.fy = event.y;
    const dx = event.x - cx;
    const dy = event.y - cy;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const limit = boundaryR - (d.radius || 6) - 12;
    if (dist > limit) {
      const angle = Math.atan2(dy, dx);
      d.fx = cx + Math.cos(angle) * limit;
      d.fy = cy + Math.sin(angle) * limit;
    }
  }

  function dragended(event, d) {
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null;
    d.fy = null;
    d3.select(this).classed("is-dragging", false);
    isDragging = false;  // 清除拖拽状态

    // 拖拽结束后继续运行，不停止模拟
  }

  // ========== Tooltip ==========
  function showTooltip(event, d) {
    if (isDragging) return;  // 拖拽时不显示tooltip
    tooltipCurrentNode = d;
    tooltipCurrentPage = 1;
    tooltipName.textContent = d.title || d.name;  // 文章用title，标签用name
    
    if (d.isPost) {
      tooltip.classList.add("is-post-tooltip");
      // 文章详情
      tooltipStats.innerHTML = d.category ? `<span class="stat-item">${d.category}</span>` : '';
      
      if (d.published) {
        const date = new Date(d.published);
        const dateStr = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        tooltipStats.innerHTML += `<span class="stat-divider">·</span><span class="stat-item">${dateStr}</span>`;
      }
      
      // 文章列表区域显示描述
      tooltipPosts.innerHTML = `<div class="post-description">${d.description || '暂无描述'}</div>`;
      
      // 获取文章的标签
      const postTags = d.tags || [];
      if (postTags.length > 0) {
        const tagIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" style="vertical-align: middle; margin-right: 4px;"><path d="M0 0h24v24H0z" fill="none"/><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"><path stroke-linejoin="round" d="M15.244 21.366a2.164 2.164 0 0 1-3.061 0l-8.549-8.549A2.16 2.16 0 0 1 3 11.287V5.164C3 3.97 3.97 3 5.164 3h6.123c.573 0 1.124.228 1.53.634l8.549 8.549a2.164 2.164 0 0 1 0 3.061z"/><path d="M6.5 6.5L7 7"/></g></svg>`;
        tooltipTags.innerHTML = `<div class="tags-list" style="display: flex; align-items: center; flex-wrap: wrap; gap: 4px;">` + tagIcon + postTags.slice(0, 6).map(t => `<span class="tag-item">#${t}</span>`).join(' ') + `</div>`;
      } else {
        tooltipTags.innerHTML = '';
      }
      
      tooltipHint.innerHTML = '<a href="' + d.url + '" target="_blank" class="hint-link"><span class="hint-icon">Tips：点击查看文章</a>';
    } else {
      tooltip.classList.remove("is-post-tooltip");
      // 标签或分类详情
      tooltipStats.innerHTML = `<span class="stat-item">${d.count} 篇文章</span>`;
      tooltipTags.innerHTML = '';
      
      // 根据当前视图判断是分类还是标签
      const isCategory = currentView === 'categories' || currentView === 'category-detail';
      
      // 获取所有关联文章，按发布时间排序
      const relatedPosts = RAW.posts
        .filter(p => isCategory ? p.category === d.id : p.tags.includes(d.id))
        .sort((a, b) => new Date(b.published || 0) - new Date(a.published || 0));
      
      const pageSize = 5;
      const totalPages = Math.ceil(relatedPosts.length / pageSize);
      const displayPosts = relatedPosts.slice((tooltipCurrentPage - 1) * pageSize, tooltipCurrentPage * pageSize);
      
      // 渲染文章列表
      if (relatedPosts.length > 0) {
        tooltipPosts.innerHTML = '';
        displayPosts.forEach((post, index) => {
          tooltipPosts.innerHTML += `
            <div class="post-item">
              <span class="post-number">${(tooltipCurrentPage - 1) * pageSize + index + 1}.</span>
              <a href="${post.url}" target="_blank" class="post-title">${post.title}</a>
            </div>
          `;
        });
        
        // 添加翻页按钮
        if (totalPages > 1) {
          tooltipPosts.innerHTML += `
            <div class="tooltip-pagination">
              <span class="pagination-btn prev" ${tooltipCurrentPage <= 1 ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipPrevPage()">‹</span>
              <span class="pagination-info">${tooltipCurrentPage}/${totalPages}</span>
              <span class="pagination-btn next" ${tooltipCurrentPage >= totalPages ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipNextPage()">›</span>
            </div>
          `;
        }
      } else {
        tooltipPosts.innerHTML = '<div class="empty-state">暂无关联文章</div>';
      }
      
      // 根据当前视图显示不同的提示
      if (isCategory) {
        tooltipHint.innerHTML = '<span style="cursor:pointer !important;" class="hint-link" onclick="switchToCategoryDetailView(\'' + d.id + '\')"><span class="hint-icon"></span>Tips：点击查看所有关联文章</span>';
      } else {
        tooltipHint.innerHTML = '<span style="cursor:pointer !important;" class="hint-link" onclick="switchToTagDetailView(\'' + d.id + '\')"><span class="hint-icon"></span>Tips：点击查看所有关联文章</span>';
      }
    }

  
    tooltip.classList.remove("hidden");

    const rect = wrapper.getBoundingClientRect();
    const padding = 16; // 安全边距
    let x = event.clientX - rect.left + 12;
    let y = event.clientY - rect.top - 8;
    const ttRect = tooltip.getBoundingClientRect();
    
    // 确保卡片不会超出右侧边界
    if (x + ttRect.width > rect.width - padding) {
      x = rect.width - ttRect.width - padding;
    }
    // 确保卡片不会超出左侧边界
    if (x < padding) {
      x = padding;
    }
    // 确保卡片不会超出底部边界
    if (y + ttRect.height > rect.height - padding) {
      y = rect.height - ttRect.height - padding;
    }
    // 确保卡片不会超出顶部边界
    if (y < padding) {
      y = padding;
    }
    
    tooltip.style.left = x + "px";
    tooltip.style.top = y + "px";
  }

  function tooltipPrevPage() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    if (tooltipCurrentPage > 1) {
      tooltipCurrentPage--;
      updateTooltipPosts();
    }
  }

  function tooltipNextPage() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    
    // 根据当前视图判断是分类还是标签
    const isCategory = currentView === 'categories' || currentView === 'category-detail';
    const relatedPosts = RAW.posts.filter(p => isCategory ? p.category === tooltipCurrentNode.id : p.tags.includes(tooltipCurrentNode.id));
    
    const totalPages = Math.ceil(relatedPosts.length / 5);
    if (tooltipCurrentPage < totalPages) {
      tooltipCurrentPage++;
      updateTooltipPosts();
    }
  }

  function updateTooltipPosts() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    
    // 根据当前视图判断是分类还是标签
    const isCategory = currentView === 'categories' || currentView === 'category-detail';
    
    const relatedPosts = RAW.posts
      .filter(p => isCategory ? p.category === tooltipCurrentNode.id : p.tags.includes(tooltipCurrentNode.id))
      .sort((a, b) => new Date(b.published || 0) - new Date(a.published || 0));
    
    const pageSize = 5;
    const totalPages = Math.ceil(relatedPosts.length / pageSize);
    const displayPosts = relatedPosts.slice((tooltipCurrentPage - 1) * pageSize, tooltipCurrentPage * pageSize);
    
    tooltipPosts.style.opacity = '0';
    setTimeout(() => {
      tooltipPosts.innerHTML = '';
      displayPosts.forEach((post, index) => {
        tooltipPosts.innerHTML += `
          <div class="post-item">
            <span class="post-number">${(tooltipCurrentPage - 1) * pageSize + index + 1}</span>
            <a href="${post.url}" target="_blank" class="post-title">${post.title}</a>
          </div>
        `;
      });
      
      // 更新页码
      if (totalPages > 1) {
        tooltipPosts.innerHTML += `
          <div class="tooltip-pagination">
            <span class="pagination-btn prev" ${tooltipCurrentPage <= 1 ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipPrevPage()">‹</span>
            <span class="pagination-info">${tooltipCurrentPage}/${totalPages}</span>
            <span class="pagination-btn next" ${tooltipCurrentPage >= totalPages ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipNextPage()">›</span>
          </div>
        `;
      }
      
      tooltipPosts.style.opacity = '1';
    }, 100);
  }

  window.tooltipPrevPage = tooltipPrevPage;
  window.tooltipNextPage = tooltipNextPage;

  // 点击按钮切换到标签详情视图
  function switchToTagDetailView(tagId) {
    tooltip.classList.add("hidden");
    const tagNode = allTagNodes.find(t => t.id === tagId);
    if (tagNode) {
      switchToPostView(tagNode);
    }
  }

  window.switchToTagDetailView = switchToTagDetailView;
  window.switchToCategoryDetailView = switchToCategoryDetailView;

  function hideTooltip() {
    // 添加延迟，确保tooltip的mouseenter事件先触发
    setTimeout(() => {
      if (!isTooltipHovered) {
        tooltip.classList.add("hidden");
        tooltipCurrentNode = null;
      }
    }, 100);
  }

  // Tooltip鼠标事件
  tooltip.addEventListener("mouseenter", () => {
    isTooltipHovered = true;
  });

  tooltip.addEventListener("mouseleave", () => {
    isTooltipHovered = false;
    // 鼠标离开tooltip后立即关闭
    tooltip.classList.add("hidden");
    tooltipCurrentNode = null;
    tooltipCurrentPage = 1;
  });

  // 关闭按钮点击事件
  tooltipClose.addEventListener("click", (e) => {
    e.stopPropagation();
    tooltip.classList.add("hidden");
    tooltipCurrentNode = null;
    tooltipCurrentPage = 1;
  });

  // ========== 搜索 ==========
  const searchInput = document.getElementById("graphSearch");
  const searchBtn = document.getElementById("graphSearchBtn");

  // 视图切换：搜索结果
  function switchToSearchView(keyword) {
    currentView = 'search';
    activeTag = null;
    activeCategory = null;
    backBtn.classList.remove("hidden");
    document.getElementById("tabBar").classList.add("hidden");
    graphTitle.textContent = `搜索「${keyword}」`;

    // 查找匹配的节点（标签和文章）
    const matchedNodes = [];
    const matchedIds = new Set();

    // 匹配标签
    RAW.tags.forEach(tag => {
      if (tag.name.toLowerCase().includes(keyword.toLowerCase())) {
        matchedNodes.push({ ...tag, isTag: true });
        matchedIds.add(tag.id);
      }
    });

    // 匹配文章
    RAW.posts.forEach(post => {
      if (post.title.toLowerCase().includes(keyword.toLowerCase()) ||
          post.description.toLowerCase().includes(keyword.toLowerCase()) ||
          post.tags.some(t => t.toLowerCase().includes(keyword.toLowerCase()))) {
        matchedNodes.push({ ...post });
        matchedIds.add(post.id);
      }
    });

    // 如果没有匹配结果
    if (matchedNodes.length === 0) {
      graphStats.textContent = "未找到匹配内容";
      // 显示空状态
      const nodes = [];
      const links = [];
      const els = renderGraph(nodes, links);
      simulation = createSimulation(nodes, links);
      return;
    }

    graphStats.textContent = `找到 ${matchedNodes.length} 个相关结果`;

    // 构建节点和连线
    const nodes = [];
    const links = [];

    // 添加匹配的节点，按相关性排序后放置在中心附近
    matchedNodes.sort((a, b) => {
      // 标题匹配优先于描述匹配
      const aTitleMatch = a.title?.toLowerCase().includes(keyword.toLowerCase()) ? 1 : 0;
      const bTitleMatch = b.title?.toLowerCase().includes(keyword.toLowerCase()) ? 1 : 0;
      return bTitleMatch - aTitleMatch;
    });

    matchedNodes.forEach((node, i) => {
      const angle = (i / matchedNodes.length) * Math.PI * 2;
      const radiusFactor = Math.sqrt(i / matchedNodes.length);
      const r = radiusFactor * boundaryR * 0.6; // 放在中心附近
      nodes.push({
        ...node,
        radius: node.radius || (node.isPost ? 5 : 10),
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
      });
    });

    // 添加文章和标签之间的关联
    nodes.forEach(node => {
      if (node.isPost && node.tags) {
        node.tags.forEach(tagId => {
          const tagNode = nodes.find(n => n.id === tagId);
          if (tagNode) {
            links.push({
              source: node.id,
              target: tagId,
              strength: 1,
            });
          }
        });
      }
    });

    // 添加标签之间的关联（共享文章的标签）
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        if (!a.isPost && !b.isPost) {
          // 检查是否有共同的文章
          const sharedPosts = RAW.posts.filter(p => 
            p.tags.includes(a.id) && p.tags.includes(b.id)
          );
          if (sharedPosts.length > 0) {
            links.push({
              source: a.id,
              target: b.id,
              strength: sharedPosts.length,
            });
          }
        }
      }
    }

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    
    // 搜索结果放大到150%
    setTimeout(() => {
      const transform = d3.zoomIdentity.translate(width / 2, height / 2).scale(1.5).translate(-width / 2, -height / 2);
      svg.transition().duration(500).call(zoom.transform, transform);
      currentZoom = transform;
    }, 100);
    
    resetIdleTimer();
  }

  function doSearch() {
    const kw = searchInput.value.trim();
    if (!kw) {
      // 清空搜索时返回当前视图
      switchView(currentView === 'search' ? 'posts' : currentView);
      return;
    }
    
    // 切换到搜索视图
    switchToSearchView(kw);
  }

  let searchDebounce;
  searchInput.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(doSearch, 250);
  });
  searchBtn.addEventListener("click", doSearch);
  searchInput.addEventListener("keydown", e => { if (e.key === "Enter") doSearch(); });

  // ========== 返回总览 ==========
  backBtn.addEventListener("click", () => {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false).style("display", "");
    // 返回总览时根据当前活动状态切换到对应视图
    if (activeCategory) {
      switchView('categories');
    } else {
      switchView('tags');
    }
  });

  // ========== 重置视图 ==========
  document.getElementById("graphReset").addEventListener("click", () => {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false).style("display", "");
    // 重置到当前选中的tab视图
    if (currentView === 'posts' && activeTag) {
      const tag = allTagNodes.find(t => t.id === activeTag);
      if (tag) switchToPostView(tag);
    } else if (currentView === 'category-detail' && activeCategory) {
      const category = RAW.categories.find(c => c.id === activeCategory);
      if (category) switchToCategoryDetailView(category);
    } else {
      switchView(currentView);
    }
  });

  // ========== resize 防抖 ==========
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      width = wrapper.clientWidth || 800;
      height = wrapper.clientHeight || 500;
      cx = width / 2;
      cy = height / 2;
      boundaryR = Math.min(width, height) * 0.72;
      updateBoundary();
      if (simulation) {
        simulation.force("center", d3.forceCenter(cx, cy).strength(0.035));
        simulation.alpha(0.3).restart();
      }
    }, 150);
  });

  // ========== Tab切换 ==========
  function switchView(viewType) {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false).style("display", "");
    
    // 更新tab状态
    document.querySelectorAll(".tab-item").forEach(el => el.classList.remove("active"));
    document.querySelector(`[data-view="${viewType}"]`)?.classList.add("active");
    
    switch(viewType) {
      case "posts":
        switchToAllPostsView();
        break;
      case "categories":
        switchToCategoryView();
        break;
      case "tags":
        switchToTagView();
        break;
      case "random":
        switchToRandomView();
        break;
    }
  }

  // Tab点击事件
  document.querySelectorAll(".tab-item").forEach(tab => {
    tab.addEventListener("click", () => {
      const viewType = tab.getAttribute("data-view");
      if (viewType) {
        switchView(viewType);
      }
    });
  });

  // ========== 初始化 ==========
  function initGraph() {
    if (hasInitialized) return;
    hasInitialized = true;
    switchView('posts'); // 默认显示全部文章视图
  }

  // 如果 D3 已加载且 wrapper 在视口内，立即初始化
  if (window.d3) {
    const rect = wrapper.getBoundingClientRect();
    const inViewport = rect.top < window.innerHeight && rect.bottom > 0;
    if (inViewport) {
      initGraph();
    } else {
      // 使用 IntersectionObserver 懒加载
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !hasInitialized) {
            initGraph();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(wrapper);
    }
  }

  // ========== 清理函数 ==========
  window.__obsidianGraphCleanup = function() {
    if (simulation) simulation.stop();
    svg.on(".zoom", null);
    clearTimeout(idleTimer);
    clearTimeout(resizeTimer);
    hasInitialized = false;
  };
})();
</script>

