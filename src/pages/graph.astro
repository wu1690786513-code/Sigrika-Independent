---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getPostUrlBySlug, removeFileExtension } from "@utils/url-utils";

// 获取所有文章
const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// 构建节点和边的数据结构 —— 只包含文章和标签
interface GraphNode {
  id: string;
  name: string;
  type: "post" | "tag";
  url?: string;
  published?: string;
  description?: string;
  category?: string;
  tagCount?: number;
  radius?: number;
}

interface GraphLink {
  source: string;
  target: string;
}

const nodes: GraphNode[] = [];
const links: GraphLink[] = [];
const tagSet = new Set<string>();
const tagToPosts: Map<string, string[]> = new Map();

// 收集标签统计
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    tagSet.add(tag);
    if (!tagToPosts.has(tag)) tagToPosts.set(tag, []);
    tagToPosts.get(tag)!.push(post.id);
  }
}

// 添加文章节点
for (const post of allPosts) {
  const tagCount = post.data.tags?.length || 0;
  nodes.push({
    id: `post-${post.id}`,
    name: post.data.title,
    type: "post",
    url: getPostUrlBySlug(removeFileExtension(post.id)),
    published: post.data.published?.toISOString?.() || String(post.data.published),
    description: post.data.description || "",
    category: post.data.category || undefined,
    tagCount,
    radius: Math.max(6, Math.min(18, 6 + tagCount * 1.5)),
  });
}

// 添加标签节点
for (const tag of tagSet) {
  nodes.push({
    id: `tag-${tag}`,
    name: tag,
    type: "tag",
    radius: 10,
  });
}

// 添加 post-tag 边
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    links.push({
      source: `post-${post.id}`,
      target: `tag-${tag}`,
    });
  }
}

const graphData = { nodes, links };
---

<MainGridLayout title="关系图谱" description="探索文章与标签之间的关联">
  <div class="graph-page-container">
    <!-- 控制面板 -->
    <div class="graph-controls card-base">
      <div class="controls-header">
        <h2 class="text-xl font-bold">关系图谱</h2>
        <p class="text-sm text-black/50 dark:text-white/50">
          共 {allPosts.length} 篇文章 · {tagSet.size} 个标签
        </p>
      </div>
      
      <div class="controls-filters">
        <div class="filter-group">
          <label class="filter-label">节点类型</label>
          <div class="filter-buttons">
            <button class="filter-btn active" data-filter="all">全部</button>
            <button class="filter-btn" data-filter="post">文章</button>
            <button class="filter-btn" data-filter="tag">标签</button>
          </div>
        </div>
        
        <div class="filter-group">
          <label class="filter-label">搜索</label>
          <input type="text" class="search-input" placeholder="搜索文章或标签..." />
        </div>
      </div>
      
      <div class="controls-legend">
        <div class="legend-item">
          <span class="legend-dot post"></span>
          <span>文章</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot tag"></span>
          <span>标签</span>
        </div>
      </div>
    </div>
    
    <!-- 图谱容器 -->
    <div class="graph-container card-base">
      <div id="graph-svg-wrapper"></div>
      
      <!-- 悬浮提示 -->
      <div id="graph-tooltip" class="graph-tooltip hidden">
        <div class="tooltip-content"></div>
      </div>
    </div>
  </div>
</MainGridLayout>

<script is:inline src="https://d3js.org/d3.v7.min.js"></script>

<script is:inline define:vars={{ graphData }}>
  (function() {
    const data = graphData;
    const container = document.getElementById('graph-svg-wrapper');
    const tooltip = document.getElementById('graph-tooltip');
    const tooltipContent = tooltip.querySelector('.tooltip-content');
    
    if (!container) return;
    
    let width = container.clientWidth || 800;
    let height = Math.max(500, window.innerHeight * 0.6);
    
    // 创建 SVG
    const svg = d3.select('#graph-svg-wrapper')
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', [0, 0, width, height]);
    
    const g = svg.append('g');
    
    // 当前缩放级别（用于控制标签显示）
    let currentScale = 1;
    const LABEL_SHOW_THRESHOLD = 1.2; // 放大到 1.2 倍以上才显示标签
    
    // 缩放行为
    const zoom = d3.zoom()
      .scaleExtent([0.15, 4])
      .on('zoom', (event) => {
        g.attr('transform', event.transform);
        currentScale = event.transform.k;
        updateLabelsByZoom();
      });
    
    svg.call(zoom);
    
    // 颜色配置
    const colors = {
      post: 'var(--primary)',
      tag: '#60a5fa',
      link: 'rgba(150, 150, 150, 0.25)',
    };
    
    // 筛选状态
    let currentNodeFilter = 'all';
    let searchQuery = '';
    
    // 力导向模拟
    let simulation = d3.forceSimulation(data.nodes)
      .force('link', d3.forceLink(data.links).id(d => d.id).distance(70).strength(0.5))
      .force('charge', d3.forceManyBody().strength(d => {
        if (d.type === 'post') return -50;
        return -120;
      }).distanceMax(350))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collision', d3.forceCollide().radius(d => (d.radius || 10) + 4).strength(0.6))
      .force('x', d3.forceX(width / 2).strength(0.02))
      .force('y', d3.forceY(height / 2).strength(0.02));
    
    // 绘制边
    const link = g.append('g')
      .attr('class', 'links')
      .selectAll('line')
      .data(data.links)
      .join('line')
      .attr('stroke-width', 1)
      .attr('stroke', colors.link);
    
    // 绘制节点组
    const node = g.append('g')
      .attr('class', 'nodes')
      .selectAll('g')
      .data(data.nodes)
      .join('g')
      .attr('class', 'node')
      .attr('cursor', d => d.type === 'post' ? 'pointer' : 'grab')
      .call(d3.drag()
        .on('start', dragstarted)
        .on('drag', dragged)
        .on('end', dragended));
    
    // 绘制节点形状
    node.each(function(d) {
      const el = d3.select(this);
      const r = d.radius || 8;
      
      if (d.type === 'post') {
        el.append('circle')
          .attr('r', r)
          .attr('fill', colors.post)
          .attr('stroke', 'var(--card-bg)')
          .attr('stroke-width', 2);
      } else {
        const size = r;
        el.append('rect')
          .attr('x', -size)
          .attr('y', -size)
          .attr('width', size * 2)
          .attr('height', size * 2)
          .attr('rx', 3)
          .attr('fill', colors.tag)
          .attr('stroke', 'var(--card-bg)')
          .attr('stroke-width', 2);
      }
    });
    
    // 节点标签 —— 默认隐藏，根据缩放控制
    const labels = g.append('g')
      .attr('class', 'labels')
      .selectAll('text')
      .data(data.nodes)
      .join('text')
      .text(d => d.name)
      .attr('font-size', d => d.type === 'post' ? 10 : 11)
      .attr('font-weight', d => d.type === 'tag' ? 'bold' : 'normal')
      .attr('fill', 'var(--deep-text)')
      .attr('dx', d => (d.radius || 8) + 4)
      .attr('dy', 3)
      .attr('pointer-events', 'none')
      .style('opacity', 0) // 默认隐藏
      .style('display', 'none');
    
    // 根据缩放级别更新标签显示
    function updateLabelsByZoom() {
      const showLabels = currentScale >= LABEL_SHOW_THRESHOLD;
      labels.style('display', d => {
        // 标签节点始终显示（如果缩放够大）
        // 文章节点只在缩放够大时显示
        if (!showLabels) return 'none';
        return null;
      }).style('opacity', d => {
        if (!showLabels) return 0;
        return d.type === 'tag' ? 0.9 : 0.7;
      });
    }
    
    // 交互事件
    node
      .on('mouseover', function(event, d) {
        // 高亮当前节点和连接的边
        link.style('opacity', l => {
          if (l.source.id === d.id || l.target.id === d.id) return 0.8;
          return 0.05;
        });
        
        node.style('opacity', n => {
          if (n.id === d.id) return 1;
          const isConnected = data.links.some(l => 
            (l.source.id === d.id && l.target.id === n.id) ||
            (l.target.id === d.id && l.source.id === n.id)
          );
          return isConnected ? 0.6 : 0.15;
        });
        
        // 悬停时显示当前节点标签（即使缩放不够）
        labels.filter(n => n.id === d.id)
          .style('display', null)
          .style('opacity', 1);
        
        // 显示提示
        showTooltip(event, d);
      })
      .on('mouseout', function() {
        link.style('opacity', 1);
        node.style('opacity', 1);
        
        // 恢复标签显示状态（由缩放控制）
        updateLabelsByZoom();
        
        hideTooltip();
      })
      .on('click', function(_event, d) {
        if (d.type === 'post' && d.url) {
          window.open(d.url, '_blank');
        }
      });
    
    // 提示框 —— 标题（大字体）、发布时间（YYYY-MM-DD）、分类、描述
    function showTooltip(event, d) {
      let html = '';
      
      if (d.type === 'post') {
        // 格式化日期为 YYYY-MM-DD
        let dateStr = '';
        if (d.published) {
          const date = new Date(d.published);
          const y = date.getFullYear();
          const m = String(date.getMonth() + 1).padStart(2, '0');
          const day = String(date.getDate()).padStart(2, '0');
          dateStr = `${y}-${m}-${day}`;
        }
        
        html = `<div class="tooltip-title">${esc(d.name)}</div>`;
        
        if (dateStr) {
          html += `<div class="tooltip-row"><span class="tooltip-label">发布时间</span><span class="tooltip-value">${dateStr}</span></div>`;
        }
        
        if (d.category) {
          html += `<div class="tooltip-row"><span class="tooltip-label">分类</span><span class="tooltip-value">${esc(d.category)}</span></div>`;
        }
        
        if (d.tagCount) {
          html += `<div class="tooltip-row"><span class="tooltip-label">标签</span><span class="tooltip-value">${d.tagCount} 个</span></div>`;
        }
        
        if (d.description) {
          html += `<div class="tooltip-desc">${esc(d.description)}</div>`;
        }
        
        html += `<div class="tooltip-hint">点击查看文章</div>`;
      } else {
        // 标签节点
        const connectedPosts = data.links.filter(l => 
          l.source.id === d.id || l.target.id === d.id
        ).length;
        html = `
          <div class="tooltip-title" style="color:#60a5fa">🏷️ ${esc(d.name)}</div>
          <div class="tooltip-row"><span class="tooltip-label">关联文章</span><span class="tooltip-value">${connectedPosts} 篇</span></div>
        `;
      }
      
      tooltipContent.innerHTML = html;
      tooltip.classList.remove('hidden');
      
      const rect = container.getBoundingClientRect();
      let x = event.clientX - rect.left + 16;
      let y = event.clientY - rect.top + 16;
      
      // 边界检查，防止提示框超出容器
      const ttRect = tooltip.getBoundingClientRect();
      if (x + ttRect.width > rect.width) x = event.clientX - rect.left - ttRect.width - 10;
      if (y + ttRect.height > rect.height) y = event.clientY - rect.top - ttRect.height - 10;
      
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
    }
    
    function hideTooltip() {
      tooltip.classList.add('hidden');
    }
    
    function esc(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }
    
    // 拖拽函数
    function dragstarted(event, d) {
      if (!event.active) simulation.alphaTarget(0.3).restart();
      d.fx = d.x;
      d.fy = d.y;
    }
    
    function dragged(event, d) {
      d.fx = event.x;
      d.fy = event.y;
    }
    
    function dragended(event, d) {
      if (!event.active) simulation.alphaTarget(0);
      d.fx = null;
      d.fy = null;
    }
    
    // 更新位置
    simulation.on('tick', () => {
      link
        .attr('x1', d => d.source.x)
        .attr('y1', d => d.source.y)
        .attr('x2', d => d.target.x)
        .attr('y2', d => d.target.y);
      
      node.attr('transform', d => `translate(${d.x},${d.y})`);
      
      labels
        .attr('x', d => d.x)
        .attr('y', d => d.y);
    });
    
    // 筛选功能
    function updateVisibility() {
      const visibleNodes = new Set();
      
      data.nodes.forEach(d => {
        let nodeVisible = true;
        if (currentNodeFilter !== 'all' && d.type !== currentNodeFilter) {
          nodeVisible = false;
        }
        if (searchQuery && !d.name.toLowerCase().includes(searchQuery.toLowerCase())) {
          nodeVisible = false;
        }
        if (nodeVisible) visibleNodes.add(d.id);
      });
      
      node.style('display', d => visibleNodes.has(d.id) ? null : 'none');
      labels.style('display', d => visibleNodes.has(d.id) ? null : 'none');
      
      link.style('display', d => {
        if (!visibleNodes.has(d.source.id) || !visibleNodes.has(d.target.id)) return 'none';
        return null;
      });
      
      // 重新应用缩放标签控制
      updateLabelsByZoom();
    }
    
    // 绑定筛选事件
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentNodeFilter = btn.dataset.filter;
        updateVisibility();
      });
    });
    
    document.querySelector('.search-input').addEventListener('input', (e) => {
      searchQuery = e.target.value;
      updateVisibility();
    });
    
    // 响应式调整
    window.addEventListener('resize', () => {
      const newWidth = container.clientWidth;
      const newHeight = Math.max(500, window.innerHeight * 0.6);
      svg.attr('width', newWidth).attr('height', newHeight);
      simulation.force('center', d3.forceCenter(newWidth / 2, newHeight / 2));
      simulation.alpha(0.3).restart();
    });
    
  })();
</script>

<style>
  .graph-page-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }
  
  .graph-controls {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .controls-header h2 {
    color: var(--deep-text);
    margin-bottom: 0.25rem;
  }
  
  .controls-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .filter-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--content-meta);
  }
  
  .filter-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .filter-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    border: 1px solid var(--line-color);
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .filter-btn:hover {
    background: var(--btn-regular-bg-hover);
  }
  
  .filter-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }
  
  .search-input {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line-color);
    background: var(--card-bg);
    color: var(--deep-text);
    font-size: 0.875rem;
    width: 220px;
    outline: none;
    transition: border-color 0.2s;
  }
  
  .search-input:focus {
    border-color: var(--primary);
  }
  
  .search-input::placeholder {
    color: var(--content-meta);
    opacity: 0.6;
  }
  
  .controls-legend {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--line-divider);
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--content-meta);
  }
  
  .legend-dot {
    width: 12px;
    height: 12px;
    display: inline-block;
  }
  
  .legend-dot.post {
    border-radius: 50%;
    background: var(--primary);
  }
  
  .legend-dot.tag {
    border-radius: 2px;
    background: #60a5fa;
  }
  
  .graph-container {
    position: relative;
    overflow: hidden;
    min-height: 500px;
  }
  
  #graph-svg-wrapper {
    width: 100%;
    height: 100%;
    min-height: 500px;
  }
  
  #graph-svg-wrapper svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  
  .graph-tooltip {
    position: absolute;
    z-index: 100;
    pointer-events: none;
    max-width: 300px;
  }
  
  .graph-tooltip.hidden {
    display: none;
  }
  
  .tooltip-content {
    background: var(--float-panel-bg);
    border: 1px solid var(--line-color);
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(8px);
  }
  
  .tooltip-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--deep-text);
    margin-bottom: 0.625rem;
    line-height: 1.4;
  }
  
  .tooltip-row {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    margin-bottom: 0.375rem;
    line-height: 1.5;
  }
  
  .tooltip-label {
    color: var(--content-meta);
    opacity: 0.7;
    min-width: 4em;
    flex-shrink: 0;
  }
  
  .tooltip-value {
    color: var(--deep-text);
  }
  
  .tooltip-desc {
    font-size: 0.8125rem;
    color: var(--content-meta);
    line-height: 1.5;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .tooltip-hint {
    font-size: 0.75rem;
    color: var(--primary);
    font-weight: 500;
    margin-top: 0.25rem;
  }
  
  :root.dark .tooltip-content {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
  
  .node {
    transition: opacity 0.2s;
  }
  
  .node:hover {
    filter: brightness(1.2);
  }
  
  @media (max-width: 768px) {
    .controls-filters {
      flex-direction: column;
      gap: 1rem;
    }
    
    .search-input {
      width: 100%;
    }
    
    .graph-container {
      min-height: 400px;
    }
    
    #graph-svg-wrapper {
      min-height: 400px;
    }
  }
</style>
