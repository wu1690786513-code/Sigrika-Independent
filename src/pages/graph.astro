---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getTagUrl, url } from "@utils/url-utils";

// ========== 1. 读取文章数据 ==========
const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// ========== 2. 收集标签及关联 ==========
const tagMap = new Map<string, { count: number; posts: string[] }>();

for (const post of allPosts) {
  const tags = post.data.tags || [];
  for (const tag of tags) {
    if (!tagMap.has(tag)) {
      tagMap.set(tag, { count: 0, posts: [] });
    }
    const t = tagMap.get(tag)!;
    t.count++;
    t.posts.push(post.id);
  }
}

// 只保留出现 >= 2 次的标签（避免过多孤立节点）
const minTagCount = 1;
const filteredTags = Array.from(tagMap.entries())
  .filter(([_, v]) => v.count >= minTagCount)
  .sort((a, b) => b[1].count - a[1].count);

// 计算标签之间的关联强度（共享文章数）
const tagNames = filteredTags.map(([name]) => name);
const tagPostSets = new Map<string, Set<string>>();
for (const [name, info] of filteredTags) {
  tagPostSets.set(name, new Set(info.posts));
}

const links: { source: string; target: string; strength: number }[] = [];
for (let i = 0; i < tagNames.length; i++) {
  for (let j = i + 1; j < tagNames.length; j++) {
    const a = tagNames[i];
    const b = tagNames[j];
    const setA = tagPostSets.get(a)!;
    const setB = tagPostSets.get(b)!;
    let shared = 0;
    for (const pid of setA) {
      if (setB.has(pid)) shared++;
    }
    if (shared > 0) {
      links.push({ source: a, target: b, strength: shared });
    }
  }
}

// 节点大小：基于标签出现次数
const counts = filteredTags.map(([_, v]) => v.count);
const maxCount = Math.max(...counts, 1);
const minCount = Math.min(...counts, 1);
const countRange = maxCount - minCount || 1;

const nodes = filteredTags.map(([name, info]) => {
  const normalized = (info.count - minCount) / countRange;
  // 半径 6~18px
  const radius = 6 + normalized * 12;
  return {
    id: name,
    name,
    count: info.count,
    url: getTagUrl(name),
    radius: Math.round(radius * 10) / 10,
    isHighFreq: normalized >= 0.5,
  };
});

// 序列化数据
const graphData = {
  nodes: nodes.map(n => ({
    id: n.id,
    name: n.name,
    count: n.count,
    url: n.url,
    radius: n.radius,
    isHighFreq: n.isHighFreq,
  })),
  links: links.map(l => ({
    source: l.source,
    target: l.target,
    strength: l.strength,
  })),
  stats: {
    totalPosts: allPosts.length,
    totalTags: nodes.length,
    totalLinks: links.length,
  },
};
---

<MainGridLayout title="知识星球" description="探索标签关联，发现知识脉络">
  <Fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js" is:inline></script>
  </Fragment>

  <div class="obsidian-graph">
    <!-- 顶部工具栏 -->
    <div class="graph-toolbar card-base">
      <div class="toolbar-left">
        <h1 class="graph-title">知识星球</h1>
        <span class="graph-stats">{graphData.stats.totalPosts} 篇文章 · {graphData.stats.totalTags} 个标签 · {graphData.stats.totalLinks} 条关联</span>
      </div>
      <div class="toolbar-right">
        <div class="search-box">
          <input type="text" class="search-input" id="graphSearch" placeholder="搜索标签..." autocomplete="off"/>
          <button class="search-btn" id="graphSearchBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
        <button class="reset-btn" id="graphReset" title="重置视图">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
      </div>
    </div>

    <!-- 图谱画布 -->
    <div class="graph-canvas-wrapper card-base" id="graphWrapper">
      <svg id="graphSvg" width="100%" height="100%">
        <defs>
          <!-- 高频标签：实心主题橘红 -->
          <radialGradient id="nodeHigh" cx="35%" cy="35%" r="65%">
            <stop offset="0%" stop-color="oklch(0.88 0.06 var(--hue))"/>
            <stop offset="100%" stop-color="oklch(0.72 0.14 var(--hue))"/>
          </radialGradient>
          <!-- 低频标签：同色系低饱和浅粉色 -->
          <radialGradient id="nodeLow" cx="35%" cy="35%" r="65%">
            <stop offset="0%" stop-color="oklch(0.94 0.02 var(--hue))"/>
            <stop offset="100%" stop-color="oklch(0.86 0.05 var(--hue))"/>
          </radialGradient>
          <!-- hover 发光 -->
          <filter id="nodeGlow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="5" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <g id="graphBoundary"></g>
        <g id="graphLinks"></g>
        <g id="graphNodes"></g>
        <g id="graphLabels"></g>
      </svg>

      <!-- 悬浮提示 -->
      <div id="graphTooltip" class="graph-tooltip hidden">
        <div class="tooltip-name" id="tooltipName"></div>
        <div class="tooltip-meta" id="tooltipMeta"></div>
      </div>

      <!-- 缩放指示器 -->
      <div class="zoom-badge" id="zoomBadge">100%</div>
    </div>
  </div>
</MainGridLayout>

<script is:inline define:vars={{ graphData }}>
(function() {
  // 如果已经初始化过，先清理
  if (window.__obsidianGraphCleanup) {
    window.__obsidianGraphCleanup();
    window.__obsidianGraphCleanup = null;
  }

  const data = graphData;
  const wrapper = document.getElementById("graphWrapper");
  if (!wrapper || !window.d3) return;

  const d3 = window.d3;
  const svg = d3.select("#graphSvg");
  const tooltip = document.getElementById("graphTooltip");
  const tooltipName = document.getElementById("tooltipName");
  const tooltipMeta = document.getElementById("tooltipMeta");
  const zoomBadge = document.getElementById("zoomBadge");

  const width = wrapper.clientWidth || 800;
  const height = wrapper.clientHeight || 500;
  const cx = width / 2;
  const cy = height / 2;
  const boundaryR = Math.min(width, height) * 0.46;

  // ========== 绘制边界虚线环 ==========
  const boundaryG = d3.select("#graphBoundary");
  boundaryG.append("circle")
    .attr("cx", cx)
    .attr("cy", cy)
    .attr("r", boundaryR)
    .attr("fill", "none")
    .attr("stroke", "oklch(0.75 0.06 var(--hue) / 0.12)")
    .attr("stroke-width", 1.5)
    .attr("stroke-dasharray", "6 8");

  // ========== 准备数据 ==========
  const nodes = data.nodes.map(d => ({ ...d, x: cx + (Math.random() - 0.5) * boundaryR * 0.6, y: cy + (Math.random() - 0.5) * boundaryR * 0.6 }));
  const links = data.links.map(d => ({ ...d }));

  // ========== D3 力导向模拟 ==========
  const simulation = d3.forceSimulation(nodes)
    .force("link", d3.forceLink(links).id(d => d.id).distance(d => 120 / Math.sqrt(d.strength + 0.5)).strength(d => Math.min(0.6, d.strength * 0.15)))
    .force("charge", d3.forceManyBody().strength(-280).distanceMax(250))
    .force("center", d3.forceCenter(cx, cy).strength(0.04))
    .force("collision", d3.forceCollide().radius(d => d.radius + 6).strength(0.7))
    .force("boundary", () => {
      for (const node of nodes) {
        const dx = node.x - cx;
        const dy = node.y - cy;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist > boundaryR - node.radius - 4) {
          const angle = Math.atan2(dy, dx);
          node.x = cx + Math.cos(angle) * (boundaryR - node.radius - 4);
          node.y = cy + Math.sin(angle) * (boundaryR - node.radius - 4);
        }
      }
    })
    .alphaDecay(0.02)
    .velocityDecay(0.35);

  // ========== 绘制连线 ==========
  const linkG = d3.select("#graphLinks");
  const linkElements = linkG.selectAll("line")
    .data(links)
    .join("line")
    .attr("class", "graph-link")
    .attr("stroke", "oklch(0.75 0.06 var(--hue) / 0.15)")
    .attr("stroke-width", d => Math.max(0.8, Math.min(3, d.strength * 0.6)))
    .attr("stroke-linecap", "round");

  // ========== 绘制节点 ==========
  const nodeG = d3.select("#graphNodes");
  const nodeElements = nodeG.selectAll("circle")
    .data(nodes)
    .join("circle")
    .attr("class", "graph-node")
    .attr("r", d => d.radius)
    .attr("fill", d => d.isHighFreq ? "url(#nodeHigh)" : "url(#nodeLow)")
    .attr("stroke", d => d.isHighFreq ? "oklch(0.68 0.12 var(--hue))" : "oklch(0.82 0.04 var(--hue))")
    .attr("stroke-width", d => d.isHighFreq ? 1.5 : 1)
    .attr("cursor", "pointer")
    .call(d3.drag()
      .on("start", dragstarted)
      .on("drag", dragged)
      .on("end", dragended));

  // ========== 绘制标签（常态隐藏，hover/放大时显示） ==========
  const labelG = d3.select("#graphLabels");
  const labelElements = labelG.selectAll("text")
    .data(nodes)
    .join("text")
    .attr("class", "graph-label")
    .attr("text-anchor", "middle")
    .attr("dy", d => -d.radius - 6)
    .attr("font-size", d => Math.max(10, Math.min(13, 9 + d.radius * 0.3)))
    .attr("font-weight", d => d.isHighFreq ? "600" : "400")
    .attr("fill", "var(--deep-text)")
    .attr("opacity", 0)
    .text(d => d.name);

  // ========== 缩放行为 ==========
  let currentZoom = d3.zoomIdentity;

  const zoomBehavior = d3.zoom()
    .scaleExtent([0.4, 3])
    .on("zoom", (event) => {
      currentZoom = event.transform;
      const k = event.transform.k;
      const layers = ["#graphBoundary", "#graphLinks", "#graphNodes", "#graphLabels"];
      layers.forEach(sel => {
        d3.select(sel).attr("transform", event.transform);
      });
      zoomBadge.textContent = Math.round(k * 100) + "%";
      labelElements.attr("opacity", k >= 1.1 ? 0.85 : 0);
    });

  svg.call(zoomBehavior)
    .on("dblclick.zoom", null);

  const initialScale = Math.min(width / 900, height / 600, 1) * 0.95;
  svg.call(zoomBehavior.transform, d3.zoomIdentity.translate((width - 900 * initialScale) / 2, (height - 600 * initialScale) / 2).scale(initialScale));

  // ========== 拖拽节点 ==========
  function dragstarted(event, d) {
    if (!event.active) simulation.alphaTarget(0.3).restart();
    d.fx = d.x;
    d.fy = d.y;
    d3.select(this).attr("filter", "url(#nodeGlow)").attr("r", d.radius * 1.25);
  }

  function dragged(event, d) {
    d.fx = event.x;
    d.fy = event.y;
    const dx = event.x - cx;
    const dy = event.y - cy;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist > boundaryR - d.radius - 4) {
      const angle = Math.atan2(dy, dx);
      d.fx = cx + Math.cos(angle) * (boundaryR - d.radius - 4);
      d.fy = cy + Math.sin(angle) * (boundaryR - d.radius - 4);
    }
  }

  function dragended(event, d) {
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null;
    d.fy = null;
    d3.select(this).attr("filter", null).attr("r", d.radius);
  }

  // ========== 每帧更新位置 ==========
  simulation.on("tick", () => {
    linkElements
      .attr("x1", d => d.source.x)
      .attr("y1", d => d.source.y)
      .attr("x2", d => d.target.x)
      .attr("y2", d => d.target.y);

    nodeElements
      .attr("cx", d => d.x)
      .attr("cy", d => d.y);

    labelElements
      .attr("x", d => d.x)
      .attr("y", d => d.y);
  });

  // ========== hover 交互：高亮关联 ==========
  let hoveredNode = null;

  nodeElements
    .on("mouseenter", function(event, d) {
      hoveredNode = d;
      d3.select(this).attr("r", d.radius * 1.3).attr("filter", "url(#nodeGlow)");
      labelElements.filter(l => l.id === d.id).attr("opacity", 0.95);

      const connectedLinkData = new Set();
      links.forEach(l => {
        if (l.source.id === d.id || l.target.id === d.id) {
          connectedLinkData.add(l);
        }
      });
      linkElements
        .attr("stroke", l => connectedLinkData.has(l) ? "oklch(0.72 0.12 var(--hue) / 0.45)" : "oklch(0.75 0.06 var(--hue) / 0.06)")
        .attr("stroke-width", l => connectedLinkData.has(l) ? Math.max(1.2, Math.min(3.5, l.strength * 0.8)) : Math.max(0.5, Math.min(2, l.strength * 0.4)));

      nodeElements
        .attr("opacity", n => {
          if (n.id === d.id) return 1;
          const isConnected = links.some(l =>
            (l.source.id === d.id && l.target.id === n.id) ||
            (l.target.id === d.id && l.source.id === n.id)
          );
          return isConnected ? 0.85 : 0.35;
        });

      labelElements
        .attr("opacity", n => {
          if (n.id === d.id) return 0.95;
          const isConnected = links.some(l =>
            (l.source.id === d.id && l.target.id === n.id) ||
            (l.target.id === d.id && l.source.id === n.id)
          );
          return isConnected ? 0.7 : 0;
        });

      showTooltip(event, d);
    })
    .on("mouseleave", function(event, d) {
      hoveredNode = null;
      d3.select(this).attr("r", d.radius).attr("filter", null);
      linkElements
        .attr("stroke", "oklch(0.75 0.06 var(--hue) / 0.15)")
        .attr("stroke-width", l => Math.max(0.8, Math.min(3, l.strength * 0.6)));
      nodeElements.attr("opacity", 1);
      const k = currentZoom.k;
      labelElements.attr("opacity", n => k >= 1.1 ? 0.85 : 0);
      hideTooltip();
    })
    .on("click", function(event, d) {
      if (d.url) window.open(d.url, "_blank");
    });

  // ========== Tooltip ==========
  function showTooltip(event, d) {
    const connectedTags = [];
    links.forEach(l => {
      if (l.source.id === d.id) connectedTags.push({ name: l.target.name, strength: l.strength });
      else if (l.target.id === d.id) connectedTags.push({ name: l.source.name, strength: l.strength });
    });
    connectedTags.sort((a, b) => b.strength - a.strength);
    const topConnected = connectedTags.slice(0, 5);

    tooltipName.textContent = d.name;
    let metaHtml = `<span class="tt-count">${d.count} 篇文章</span>`;
    if (topConnected.length > 0) {
      metaHtml += `<span class="tt-divider">·</span><span class="tt-links">关联: ${topConnected.map(t => `${t.name}(${t.strength})`).join(" ")}</span>`;
    }
    tooltipMeta.innerHTML = metaHtml;

    tooltip.classList.remove("hidden");

    const rect = wrapper.getBoundingClientRect();
    let x = event.clientX - rect.left + 14;
    let y = event.clientY - rect.top - 10;

    const ttRect = tooltip.getBoundingClientRect();
    if (x + ttRect.width > rect.width) x = event.clientX - rect.left - ttRect.width - 10;
    if (y + ttRect.height > rect.height) y = event.clientY - rect.top - ttRect.height - 10;
    if (y < 0) y = 10;

    tooltip.style.left = x + "px";
    tooltip.style.top = y + "px";
  }

  function hideTooltip() {
    tooltip.classList.add("hidden");
  }

  // ========== 搜索 ==========
  const searchInput = document.getElementById("graphSearch");
  const searchBtn = document.getElementById("graphSearchBtn");

  function doSearch() {
    const kw = searchInput.value.trim().toLowerCase();
    if (!kw) {
      nodeElements.attr("opacity", 1);
      linkElements.attr("stroke", "oklch(0.75 0.06 var(--hue) / 0.15)");
      labelElements.attr("opacity", currentZoom.k >= 1.1 ? 0.85 : 0);
      return;
    }
    const matched = new Set();
    nodes.forEach(n => {
      if (n.name.toLowerCase().includes(kw)) matched.add(n.id);
    });
    nodeElements.attr("opacity", d => matched.has(d.id) ? 1 : 0.15);
    linkElements.attr("stroke", d => matched.has(d.source.id) && matched.has(d.target.id) ? "oklch(0.72 0.12 var(--hue) / 0.35)" : "oklch(0.75 0.06 var(--hue) / 0.03)");
    labelElements.attr("opacity", d => matched.has(d.id) ? 0.9 : 0);
  }

  let searchDebounce;
  searchInput.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(doSearch, 250);
  });
  searchBtn.addEventListener("click", doSearch);
  searchInput.addEventListener("keydown", e => { if (e.key === "Enter") doSearch(); });

  // ========== 重置视图 ==========
  document.getElementById("graphReset").addEventListener("click", () => {
    searchInput.value = "";
    const s = Math.min(width / 900, height / 600, 1) * 0.95;
    svg.transition().duration(600).call(zoomBehavior.transform, d3.zoomIdentity.translate((width - 900 * s) / 2, (height - 600 * s) / 2).scale(s));
    nodeElements.attr("opacity", 1);
    linkElements.attr("stroke", "oklch(0.75 0.06 var(--hue) / 0.15)");
    labelElements.attr("opacity", 0);
    simulation.alpha(0.8).restart();
  });

  // ========== 清理函数（Swup 导航时调用） ==========
  window.__obsidianGraphCleanup = function() {
    simulation.stop();
    svg.on(".zoom", null);
    nodeElements.on("mouseenter", null).on("mouseleave", null).on("click", null);
    searchInput.removeEventListener("input", doSearch);
    searchBtn.removeEventListener("click", doSearch);
    document.getElementById("graphReset").removeEventListener("click", doSearch);
  };
})();
</script>

<style>
  .obsidian-graph {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
  }

  /* 工具栏 */
  .graph-toolbar {
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .toolbar-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .graph-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--deep-text);
    margin: 0;
    line-height: 1.3;
  }
  .graph-stats {
    font-size: 0.8125rem;
    color: var(--content-meta);
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .search-box {
    display: flex;
    align-items: center;
    border: 1px solid var(--line-color);
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--card-bg);
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 220px;
  }
  .search-box:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px oklch(0.70 0.08 var(--hue) / 0.12);
  }
  .search-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: none;
    background: transparent;
    color: var(--deep-text);
    font-size: 0.875rem;
    outline: none;
  }
  .search-input::placeholder { color: var(--content-meta); opacity: 0.55; }
  .search-btn, .reset-btn {
    padding: 0.5rem 0.625rem;
    border: none;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .search-btn:hover, .reset-btn:hover { background: var(--btn-regular-bg-hover); }
  .reset-btn { border-radius: 0.5rem; }

  /* 画布 */
  .graph-canvas-wrapper {
    position: relative;
    overflow: hidden;
    min-height: 480px;
    height: 65vh;
    background: var(--page-bg);
    border-radius: var(--radius-large);
    border: 1px solid var(--line-color);
  }
  .graph-canvas-wrapper svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 节点 */
  .graph-node {
    transition: filter 0.15s ease;
    cursor: pointer;
  }
  .graph-node:hover {
    filter: brightness(1.15);
  }

  /* 连线 */
  .graph-link {
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
    pointer-events: none;
  }

  /* 标签 */
  .graph-label {
    font-family: 'Roboto', 'LXGW WenKai Screen', sans-serif;
    pointer-events: none;
    text-shadow:
      0 0 4px var(--page-bg),
      0 0 8px var(--page-bg),
      0 1px 2px var(--page-bg);
    transition: opacity 0.25s ease;
  }

  /* Tooltip */
  .graph-tooltip {
    position: absolute;
    z-index: 100;
    pointer-events: none;
    max-width: 280px;
  }
  .graph-tooltip.hidden { display: none; }
  .graph-tooltip > div {
    background: var(--float-panel-bg);
    border: 1px solid oklch(0.75 0.05 var(--hue) / 0.18);
    border-radius: 0.625rem;
    padding: 0.75rem 1rem;
    box-shadow: 0 6px 24px oklch(0.40 0.04 var(--hue) / 0.15);
    backdrop-filter: blur(10px);
  }
  .tooltip-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--deep-text);
    margin-bottom: 0.375rem;
  }
  .tooltip-meta {
    font-size: 0.8125rem;
    color: var(--content-meta);
    line-height: 1.5;
  }
  .tt-count { color: var(--primary); font-weight: 500; }
  .tt-divider { margin: 0 0.375rem; opacity: 0.4; }
  .tt-links { opacity: 0.75; }

  /* 缩放指示器 */
  .zoom-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: oklch(0.30 0.02 var(--hue) / 0.5);
    color: oklch(0.92 0.01 var(--hue));
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    pointer-events: none;
    user-select: none;
    backdrop-filter: blur(4px);
  }

  /* 移动端适配 */
