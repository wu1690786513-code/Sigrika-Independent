<!-- Tooltip 全局样式 -->
<style is:global>
     /* 节点 - 使用小球颜色 */
  .graph-node {
    will-change: cx, cy, r, filter;
    transition: r 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease, fill 0.25s ease;
    cursor: pointer;
    fill: var(--ball-color);
    stroke: black;
    stroke-width: 1.5;
    stroke-opacity: 1;
  }
  .graph-node.is-high {
    stroke-width: 1.5;
  }
  .graph-node.is-low {
    stroke-width: 1;
  }
  .graph-node.is-post {
    stroke-width: 1;
  }
  .graph-node.is-hovered {
    fill: color-mix(in srgb, var(--ball-color) 85%, black);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--ball-color) 70%, transparent)) drop-shadow(0 0 16px color-mix(in srgb, var(--ball-color) 40%, transparent));
    stroke-width: 0;
    stroke-opacity: 0;
  }
  .graph-node.is-dragging {
    fill: color-mix(in srgb, var(--ball-color) 85%, black);
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--ball-color) 80%, transparent)) drop-shadow(0 0 20px color-mix(in srgb, var(--ball-color) 50%, transparent));
    stroke-width: 0;
    stroke-opacity: 0;
  }

  /* 高亮模式 */
  .highlight-mode .graph-node { opacity: 0.25; }
  .highlight-mode .graph-node.is-hovered { opacity: 1; }
  .highlight-mode .graph-node.is-connected { opacity: 0.7; }
  .highlight-mode .graph-link { opacity: 0.06; }
  .highlight-mode .graph-link.is-connected { opacity: 1; }
  /* 高亮模式下标签保持可见，只调整非hover/非connected标签的透明度 */
  .highlight-mode .graph-label { opacity: 0.4; }
