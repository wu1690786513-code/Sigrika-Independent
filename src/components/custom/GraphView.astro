<script is:inline define:vars={{ graphData }}>
(function() {
  if (window.__obsidianGraphCleanup) {
    window.__obsidianGraphCleanup();
    window.__obsidianGraphCleanup = null;
  }

  const RAW = graphData;
  const wrapper = document.getElementById("graphWrapper");
  const container = document.getElementById("obsidianGraph");
  if (!wrapper) return;

  // 等待 D3 加载完成
  // if (!window.d3) {
  //   const d3Script = document.querySelector('script[src*="d3"]');
  //   if (d3Script) {
  //     d3Script.addEventListener('load', initGraph);
  //   }
  //   return;
  // }
  // 等待 D3 加载完成（稳定版）
function tryInit() {
  if (window.d3) {
    initGraph();
  } else {
    setTimeout(tryInit, 30);
  }
}
document.addEventListener('DOMContentLoaded', tryInit);

  const d3 = window.d3;
  const svg = d3.select("#graphSvg");
  const viewport = d3.select("#graphViewport");
  
  // 文章卡片元素
  const tooltipPost = document.getElementById("graphTooltipPost");
  const tooltipNamePost = document.getElementById("tooltipNamePost");
  const tooltipStatsPost = document.getElementById("tooltipStatsPost");
  const tooltipPostsPost = document.getElementById("tooltipPostsPost");
  const tooltipTagsPost = document.getElementById("tooltipTagsPost");
  const tooltipHintPost = document.getElementById("tooltipHintPost");
  const tooltipClosePost = document.getElementById("tooltipClosePost");
  
  // 标签/分类卡片元素
  const tooltipTag = document.getElementById("graphTooltipTag");
  const tooltipNameTag = document.getElementById("tooltipNameTag");
  const tooltipStatsTag = document.getElementById("tooltipStatsTag");
  const tooltipPostsTag = document.getElementById("tooltipPostsTag");
  const tooltipHintTag = document.getElementById("tooltipHintTag");
  const tooltipCloseTag = document.getElementById("tooltipCloseTag");
  
  let tooltipCurrentNode = null;
  let tooltipCurrentPage = 1;
  let isTooltipHoveredPost = false;
  let isTooltipHoveredTag = false;
  
  // 隐藏tooltip的延迟计时器
  let hideTooltipTimer = null;
  const HIDE_DELAY = 200; // 延迟200ms隐藏，确保tooltip能捕获mouseenter

  function hideTooltip() {
    // 清除之前的计时器
    if (hideTooltipTimer) {
      clearTimeout(hideTooltipTimer);
      hideTooltipTimer = null;
    }
    
    // 延迟隐藏，给tooltip足够的时间来判断鼠标是否真的离开了
    hideTooltipTimer = setTimeout(() => {
      // 只有当tooltip没有被hover时才隐藏
      if (!isTooltipHoveredPost && !isTooltipHoveredTag) {
        tooltipPost.classList.add("hidden");
        tooltipTag.classList.add("hidden");
        tooltipCurrentNode = null;
        tooltipCurrentPage = 1;
      }
      hideTooltipTimer = null;
    }, HIDE_DELAY);
  }

  // 取消隐藏tooltip
  function cancelHideTooltip() {
    if (hideTooltipTimer) {
      clearTimeout(hideTooltipTimer);
      hideTooltipTimer = null;
    }
  }
  
  let isDragging = false;  // 拖拽状态标志
  const zoomBadge = document.getElementById("zoomBadge");
  const backBtn = document.getElementById("backBtn");
  const graphTitle = document.getElementById("graphTitle");
  const graphStats = document.getElementById("graphStats");

  // ========== 尺寸 & 边界 ==========
  let width = wrapper.clientWidth || 800;
  let height = wrapper.clientHeight || 500;
  let cx = width / 2;
  let cy = height / 2;
  let boundaryR = Math.min(width, height) * 0.72;

  const isMobile = window.innerWidth < 768;

  // ========== 状态 ==========
  let currentView = 'posts'; // 'posts' | 'tags' | 'categories' | 'category-detail' | 'random'
  let activeTag = null;
  let activeCategory = null;
  let currentZoom = d3.zoomIdentity;
  let simulation = null;
  let tickCount = 0;
  let postDragTicks = 0;
  let idleTimer = null;
  let resizeTimer = null;
  let isVisible = false;
  let hasInitialized = false;

  // ========== 数据准备 ==========
  // 移动端过滤低频标签
  const visibleTagIds = new Set(
    isMobile ? RAW.tags.filter(t => t.count >= 3).map(t => t.id) : RAW.tags.map(t => t.id)
  );

  const allTagNodes = RAW.tags.map(d => ({ ...d, x: cx + (Math.random() - 0.5) * boundaryR * 0.9, y: cy + (Math.random() - 0.5) * boundaryR * 0.9 }));
  const allTagLinks = RAW.tagLinks.filter(l => visibleTagIds.has(l.source) && visibleTagIds.has(l.target));

  // 移除闲置检测，让模拟持续运行
  function resetIdleTimer() {} // 空函数，保持兼容

  // ========== 缩放行为 ==========
  const zoomBehavior = d3.zoom()
    .scaleExtent([0.35, 3])
    .on("zoom", function(event) {
      currentZoom = event.transform;
      viewport.attr("transform", event.transform);
      zoomBadge.textContent = Math.round(event.transform.k * 100) + "%";
      // 标签默认全显示，不再根据缩放级别控制
    });

  svg.call(zoomBehavior).on("dblclick.zoom", null);

  function resetZoom() {
    // 手机端默认放大到65%，桌面端自适应
    const mobileScale = 0.65;
    const desktopScale = Math.min(width / 900, height / 600, 1) * 0.92;
    const s = isMobile ? mobileScale : desktopScale;
    // 以画布中心为基准进行缩放，确保居中
    const tx = width / 2 * (1 - s);
    const ty = height / 2 * (1 - s);
    svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity.translate(tx, ty).scale(s));
  }

  // ========== 力导向模拟 ==========
  function createSimulation(nodes, links) {
    if (simulation) simulation.stop();
    tickCount = 0;

    // 移动端优化参数
    const mobileFactor = isMobile ? 0.6 : 1;

    const sim = d3.forceSimulation(nodes)
      .force("link", d3.forceLink(links).id(d => d.id).distance(d => {
        // 关联越强距离越近
        const base = currentView === 'tags' ? 120 : 80;
        return base / Math.sqrt((d.strength || 1) + 0.3);
      }).strength(d => {
        const baseStrength = currentView === 'tags'
          ? Math.min(0.4, (d.strength || 1) * 0.18)
          : 0.4;
        return baseStrength * (isMobile ? 0.5 : 1); // 移动端力强度减半
      }))
      .force("charge", d3.forceManyBody().strength(d => {
        // 标签节点斥力大，文章节点斥力小
        const baseCharge = d.isPost ? -80 : -150;
        return baseCharge * mobileFactor;
      }).distanceMax(isMobile ? 150 : 220)) // 移动端减少作用距离
      .force("center", d3.forceCenter(cx, cy).strength(isMobile ? 0.08 : 0.02)) // 移动端增强向心力
      .force("collision", d3.forceCollide().radius(d => (d.radius || 6) + 5).strength(isMobile ? 0.3 : 0.4))
      // 移动端取消边界检测以提升性能，通过调整力参数确保小球保持在屏幕内
      .alpha(isMobile ? 0.25 : 0.4)
      .alphaDecay(isMobile ? 0.035 : 0.02) // 移动端更快衰减，更快稳定
      .velocityDecay(isMobile ? 0.4 : 0.25) // 移动端更快减速
      .stop(); // 先停止，等待渲染后启动

    return sim;
  }

  // 移动端模拟自动停止定时器
  let mobileStopTimer = null;
  function scheduleMobileStop() {
    if (mobileStopTimer) clearTimeout(mobileStopTimer);
    if (isMobile) {
      mobileStopTimer = setTimeout(() => {
        if (simulation) {
          simulation.stop();
        }
      }, 6000); // 移动端6秒后停止模拟
    }
  }

  // ========== 渲染函数 ==========
  function renderGraph(nodes, links) {
    const linkG = d3.select("#graphLinks");
    const nodeG = d3.select("#graphNodes");
    const labelG = d3.select("#graphLabels");

    // 清空旧内容
    linkG.selectAll("*").remove();
    nodeG.selectAll("*").remove();
    labelG.selectAll("*").remove();

    // --- 连线 ---
    const linkSel = linkG.selectAll("line")
      .data(links)
      .join("line")
      .attr("class", d => `graph-link l-${escClass(d.source.id || d.source)}-${escClass(d.target.id || d.target)}`)
      .attr("stroke-width", d => Math.max(0.6, Math.min(2.5, (d.strength || 1) * 0.5)))
      .attr("stroke-linecap", "round");

    // --- 节点 ---
    const nodeSel = nodeG.selectAll("circle")
      .data(nodes)
      .join("circle")
      .attr("class", d => `graph-node n-${escClass(d.id)} ${d.isPost ? 'is-post' : ''} ${d.isHighFreq ? 'is-high' : 'is-low'}`)
      .attr("r", d => d.radius || 6)
      .attr("cursor", "pointer")
      .call(d3.drag()
        .on("start", dragstarted)
        .on("drag", dragged)
        .on("end", dragended));

    // --- 标签 ---
    const labelSel = labelG.selectAll("text")
      .data(nodes)
      .join("text")
      .attr("class", d => `graph-label n-${escClass(d.id)} ${d.isPost ? 'is-post' : ''} is-visible`)
      .attr("text-anchor", "middle")
      .attr("dy", d => -(d.radius || 6) - 5)
      .attr("font-size", d => d.isPost ? 9 : Math.max(10, Math.min(13, 9 + (d.radius || 6) * 0.25)))
      .attr("font-weight", d => d.isHighFreq ? "600" : "400")
      .text(d => d.title || d.name);

    // 绑定交互
    nodeSel
      .on("mouseenter", function(event, d) {
        // 如果正在拖动，不触发hover效果
        if (isDragging) return;
        
        // 取消任何待执行的隐藏操作
        cancelHideTooltip();
        
        const nid = d.id;
        
        // 先添加 is-hovered 类，再添加 highlight-mode，避免闪烁
        d3.select(this).classed("is-hovered", true);
        container.classList.add("highlight-mode");

        // 标记关联的连线和节点
        const connectedIds = new Set();
        links.forEach(l => {
          const sid = l.source.id || l.source;
          const tid = l.target.id || l.target;
          if (sid === nid || tid === nid) {
            connectedIds.add(sid === nid ? tid : sid);
            d3.select(`.l-${escClass(sid)}-${escClass(tid)}`).classed("is-connected", true);
            d3.select(`.l-${escClass(tid)}-${escClass(sid)}`).classed("is-connected", true);
          }
        });

        d3.selectAll(".graph-node").each(function(n) {
          if (n.id === nid) return;
          d3.select(this).classed("is-connected", connectedIds.has(n.id));
        });

        d3.selectAll(".graph-label").each(function(n) {
          if (n.id === nid) {
            d3.select(this).classed("is-hovered", true);
          } else if (connectedIds.has(n.id)) {
            d3.select(this).classed("is-connected", true);
          } else {
            d3.select(this).classed("is-hovered", false).classed("is-connected", false);
          }
        });

        showTooltip(event, d);
      })
      .on("mouseleave", function(event, d) {
        // 如果正在拖动，不触发mouseleave效果
        if (isDragging) return;
        
        // 先移除 highlight-mode，再移除 is-hovered，避免闪烁
        container.classList.remove("highlight-mode");
        d3.select(this).classed("is-hovered", false);
        d3.selectAll(".graph-link").classed("is-connected", false);
        d3.selectAll(".graph-node").classed("is-connected", false);
        d3.selectAll(".graph-label").classed("is-hovered", false).classed("is-connected", false);
        
        hideTooltip();
      })
      .on("click", function(event, d) {
        event.stopPropagation();
        if (d.isPost && d.url) {
          window.open(d.url, "_blank");
        } else if (!d.isPost) {
          // 根据当前视图判断是分类还是标签
          if (currentView === 'categories') {
            // 点击分类 → 切换到分类详情视图
            switchToCategoryDetailView(d);
          } else {
            // 点击标签 → 切换到文章-标签视图
            switchToPostView(d);
          }
        }
      });

    return { linkSel, nodeSel, labelSel };
  }

  function escClass(s) {
    return String(s).replace(/[^a-zA-Z0-9\u4e00-\u9fa5]/g, '_');
  }

