  // ========== 视图切换：全部文章 ==========
  function switchToAllPostsView() {
    currentView = 'posts';
    activeTag = null;
    activeCategory = null;
    backBtn.classList.add("hidden");
    document.getElementById("toolbarTabs").classList.remove("hidden");
    graphTitle.textContent = "次元星球";
    graphStats.textContent = `共计${RAW.stats.totalPosts} 篇文章`;

    // 按发布时间排序，最近的文章在中心附近
    const sortedPosts = [...RAW.posts].sort((a, b) => 
      new Date(b.published || 0) - new Date(a.published || 0)
    );

    // 文章节点：计算目标位置（爱心形状分布，均匀采样）
    // 爱心曲线参数方程：x = 16 * sin³(t), y = -(13*cos(t) - 5*cos(2t) - 2*cos(3t) - cos(4t))
    const heartScale = boundaryR * 0.8 / 18; // 爱心大小
    const n = sortedPosts.length;
    
    // 数值积分计算爱心曲线总弧长，用于均匀分布
    const dt = 0.01;
    let totalArcLength = 0;
    const arcLengths = [0]; // 累计弧长
    let px = 16 * Math.pow(Math.sin(0), 3);
    let py = -(13 * Math.cos(0) - 5 * Math.cos(0) - 2 * Math.cos(0) - Math.cos(0));
    for (let t = dt; t <= Math.PI * 2 + dt; t += dt) {
      const x = 16 * Math.pow(Math.sin(t), 3);
      const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
      totalArcLength += Math.sqrt((x - px) ** 2 + (y - py) ** 2);
      arcLengths.push(totalArcLength);
      px = x; py = y;
    }
    
    // 均匀采样：根据弧长确定每个点的参数 t
    const getHeartPoint = (arcLen) => {
      // 找到对应的参数区间
      for (let i = 0; i < arcLengths.length - 1; i++) {
        if (arcLengths[i + 1] >= arcLen) {
          const localT = (arcLen - arcLengths[i]) / (arcLengths[i + 1] - arcLengths[i]);
          const t = (i + localT) * dt;
          const hx = 16 * Math.pow(Math.sin(t), 3);
          const hy = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
          return { x: cx + hx * heartScale, y: cy + hy * heartScale };
        }
      }
      // 最后一个点
      const t = Math.PI * 2;
      return {
        x: cx + 16 * Math.pow(Math.sin(t), 3) * heartScale,
        y: cy + (-(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t))) * heartScale
      };
    };
    
    const postNodes = sortedPosts.map((p, i) => {
      // 均匀分布：每个点沿弧长间隔相同
      const targetArcLen = (i / n) * totalArcLength;
      const target = getHeartPoint(targetArcLen);
      // 从外围入场：初始位置在边界圆上随机位置
      const startAngle = Math.random() * Math.PI * 2;
      const startR = boundaryR * (0.85 + Math.random() * 0.15);
      return {
        id: p.id,
        name: p.title,
        title: p.title,
        url: p.url,
        isPost: true,
        radius: Math.max(4, 7 - i * 0.02),
        x: cx + Math.cos(startAngle) * startR,
        y: cy + Math.sin(startAngle) * startR,
        startX: cx + Math.cos(startAngle) * startR,
        startY: cy + Math.sin(startAngle) * startR,
        targetX: target.x,
        targetY: target.y,
        published: p.published,
        description: p.description,
        category: p.category,
        tags: p.tags,
      };
    });

    // 全部文章视图不显示连线
    const nodes = postNodes;
    const links = [];

    const els = renderGraph(nodes, links);
    
    // 初始时隐藏所有节点（透明度为0）
    els.nodeSel.style("opacity", 0);
    els.labelSel.style("opacity", 0);

    // 外围入场动画：小球从边界飞向目标位置
    const totalDuration = 3000; // 总动画时长
    const staggerDelay = 20; // 每个节点延迟
    const startTime = performance.now();
    const totalNodes = nodes.length;

    function animate(currentTime) {
      const elapsed = currentTime - startTime;
      const globalProgress = Math.min(1, elapsed / totalDuration);
      
      nodes.forEach((node, index) => {
        // 计算每个节点的入场时间（外围先入场，越靠中心越晚）
        const nodeProgress = Math.max(0, Math.min(1, (globalProgress * totalDuration - index * staggerDelay) / (totalDuration - totalNodes * staggerDelay)));
        
        if (nodeProgress > 0) {
          // 使用缓动函数：easeOutQuart 让入场更自然
          const easedProgress = 1 - Math.pow(1 - nodeProgress, 4);
          
          // 从外围位置向目标位置移动
          node.x = node.startX + (node.targetX - node.startX) * easedProgress;
          node.y = node.startY + (node.targetY - node.startY) * easedProgress;
          
          // 更新DOM位置和透明度
          els.nodeSel.filter(d => d.id === node.id)
            .attr("cx", node.x)
            .attr("cy", node.y)
            .style("opacity", easedProgress);
          els.labelSel.filter(d => d.id === node.id)
            .attr("x", node.x)
            .attr("y", node.y)
            .style("opacity", easedProgress);
        }
      });

      if (elapsed < totalDuration) {
        requestAnimationFrame(animate);
      } else {
        // 动画完成后设置最终位置并启动物理模拟
        nodes.forEach(node => {
          node.x = node.targetX;
          node.y = node.targetY;
          node.vx = 0;
          node.vy = 0;
        });
        
        els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y).style("opacity", 1);
        els.labelSel.attr("x", d => d.x).attr("y", d => d.y).style("opacity", 1);
        
        // 启动物理模拟（优化手机端性能，保持散开效果）
        simulation = createSimulation(nodes, links);
        simulation
          .alpha(0.6)  // 增加初始活跃度，让散开更明显
          .alphaDecay(0.015)  // 减慢衰减速度
          .velocityDecay(0.12);  // 减慢速度衰减

        simulation
          .force("charge", d3.forceManyBody().strength(-28).distanceMax(110))  // 增强斥力，让节点散开
          .force("center", d3.forceCenter(cx, cy).strength(0.01))  // 适当的向心力
          .force("collision", d3.forceCollide().radius(d => (d.radius || 6) + 6).strength(0.4));  // 适当的碰撞检测

        tickCount = 0;
        simulation.on("tick", () => {
          tickCount++;
          els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
          els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
        });
        
        simulation.restart();
      }
    }

    requestAnimationFrame(animate);

    resetZoom();
    resetIdleTimer();
  }

  // ========== 视图切换：随机漫步 ==========
  function switchToRandomView() {
    currentView = 'random';
    activeTag = null;
    activeCategory = null;
    backBtn.classList.add("hidden");
    document.getElementById("toolbarTabs").classList.remove("hidden");
    graphTitle.textContent = "随机漫步";
    graphStats.textContent = "会邂逅哪段记忆呢";

    // 随机挑选10篇文章
    const shuffled = [...RAW.posts].sort(() => Math.random() - 0.5);
    const randomPosts = shuffled.slice(0, Math.min(10, RAW.posts.length));

    // 文章节点：球体放大显示
    const postNodes = randomPosts.map((p, i) => {
      const angle = (i / randomPosts.length) * Math.PI * 2;
      const radiusFactor = Math.sqrt(Math.random());
      const r = radiusFactor * boundaryR * 0.6; // 适当放大，更分散
      return {
        id: p.id,
        name: p.title,
        title: p.title,
        url: p.url,
        isPost: true,
        radius: 8 + Math.random() * 4, // 适当放大
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
        published: p.published,
        description: p.description,
        category: p.category,
        tags: p.tags,
      };
    });

    // 文章之间的关联
    const postLinks = [];
    for (let i = 0; i < postNodes.length; i++) {
      for (let j = i + 1; j < postNodes.length; j++) {
        const a = postNodes[i];
        const b = postNodes[j];
        const sharedTags = (a.tags || []).filter(t => (b.tags || []).includes(t)).length;
        if (sharedTags >= 1) {
          postLinks.push({
            source: a.id,
            target: b.id,
            strength: sharedTags,
          });
        }
      }
    }

    const nodes = postNodes;
    const links = postLinks;

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    tickCount = 0;
    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    // 随机漫步模式适当放大显示
    const mobileScale = 0.8;
    const desktopScale = Math.min(width / 800, height / 500, 1) * 0.95;
    const s = isMobile ? mobileScale : desktopScale;
    const tx = width / 2 * (1 - s);
    const ty = height / 2 * (1 - s);
    svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity.translate(tx, ty).scale(s));
    resetIdleTimer();
  }

  // ========== 拖拽节点 ==========
  function dragstarted(event, d) {
    if (!event.active) {
      simulation.alphaTarget(0.25).restart();
    }
    d.fx = d.x;
    d.fy = d.y;
    d3.select(this).classed("is-dragging", true).classed("is-hovered", true);
    postDragTicks = 0;
    simulation.on("tick.postdrag", null);
    isDragging = true;  // 设置拖拽状态
  }

  function dragged(event, d) {
    d.fx = event.x;
    d.fy = event.y;
    const dx = event.x - cx;
    const dy = event.y - cy;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const limit = boundaryR - (d.radius || 6) - 12;
    if (dist > limit) {
      const angle = Math.atan2(dy, dx);
      d.fx = cx + Math.cos(angle) * limit;
      d.fy = cy + Math.sin(angle) * limit;
    }
  }

  function dragended(event, d) {
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null;
    d.fy = null;
    d3.select(this).classed("is-dragging", false).classed("is-hovered", false);
    isDragging = false;  // 清除拖拽状态

    // 拖拽结束后继续运行，不停止模拟
  }

  // ========== Tooltip ==========
  function showTooltip(event, d) {
    if (isDragging) return;  // 拖拽时不显示tooltip
    tooltipCurrentNode = d;
    tooltipCurrentPage = 1;
    
    // 立即隐藏所有tooltip（不用延迟，避免与showTooltip冲突）
    tooltipPost.classList.add("hidden");
    tooltipTag.classList.add("hidden");
    
    if (d.isPost) {
      showPostTooltip(event, d);
    } else {
      showTagTooltip(event, d);
    }
  }
  
  // 显示文章卡片
  function showPostTooltip(event, d) {
    if (d.url) {
      tooltipNamePost.innerHTML = `<a href="${d.url}" target="_blank" style="color: inherit; text-decoration: none; cursor: pointer;">${d.title || d.name}</a>`;
    } else {
      tooltipNamePost.textContent = d.title || d.name;
    }
    
    // 文章详情
    if (d.category) {
      tooltipStatsPost.innerHTML = `<span class="stat-item category-clickable" data-category="${d.category}" style="cursor: pointer;">${d.category}</span>`;
    } else {
      tooltipStatsPost.innerHTML = '';
    }
    
    if (d.published) {
      const date = new Date(d.published);
      const dateStr = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
      tooltipStatsPost.innerHTML += `<span class="stat-divider">·</span><span class="stat-item">${dateStr}</span>`;
    }
    
    // 为分类添加点击事件
    tooltipStatsPost.querySelectorAll('.category-clickable').forEach(catEl => {
      catEl.addEventListener('click', (e) => {
        e.stopPropagation();
        const categoryId = catEl.getAttribute('data-category');
        const categoryNode = RAW.categories.find(c => c.id === categoryId);
        if (categoryNode) {
          hideTooltip();
          switchToCategoryDetailView(categoryNode);
        }
      });
    });
    
    // 文章列表区域显示描述
    tooltipPostsPost.innerHTML = `<div class="post-description">${d.description || '暂无描述'}</div>`;
    
    // 获取文章的标签
    const postTags = d.tags || [];
    if (postTags.length > 0) {
      const tagIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" style="vertical-align: middle; margin-right: 4px;"><path d="M0 0h24v24H0z" fill="none"/><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"><path stroke-linejoin="round" d="M15.244 21.366a2.164 2.164 0 0 1-3.061 0l-8.549-8.549A2.16 2.16 0 0 1 3 11.287V5.164C3 3.97 3.97 3 5.164 3h6.123c.573 0 1.124.228 1.53.634l8.549 8.549a2.164 2.164 0 0 1 0 3.061z"/><path d="M6.5 6.5L7 7"/></g></svg>`;
      tooltipTagsPost.innerHTML = `<div class="tags-list" style="display: flex; align-items: center; flex-wrap: wrap; gap: 4px;">${tagIcon}${postTags.slice(0, 6).map(t => `<span class="tag-item tag-clickable" data-tag="${t}" style="cursor: pointer;">#${t}</span>`).join(' ')}</div>`;
      
      // 为标签添加点击事件
      tooltipTagsPost.querySelectorAll('.tag-clickable').forEach(tagEl => {
        tagEl.addEventListener('click', (e) => {
          e.stopPropagation();
          const tagId = tagEl.getAttribute('data-tag');
          const tagNode = RAW.tags.find(t => t.id === tagId);
          if (tagNode) {
            hideTooltip();
            switchToPostView(tagNode);
          }
        });
      });
    } else {
      tooltipTagsPost.innerHTML = '';
    }
    
    tooltipHintPost.innerHTML = '<a href="' + d.url + '" target="_blank" class="hint-link"><span class="hint-icon">Tips：点击查看文章</a>';
    
    // 显示文章卡片
    tooltipPost.classList.remove("hidden");
    
    positionTooltip(event, tooltipPost);
  }
  
  // 显示标签/分类卡片
  function showTagTooltip(event, d) {
    tooltipNameTag.textContent = d.title || d.name;
    
    // 标签或分类详情
    tooltipStatsTag.innerHTML = `<span class="stat-item">${d.count} 篇文章</span>`;
    
    // 根据当前视图判断是分类还是标签
    const isCategory = currentView === 'categories' || currentView === 'category-detail';
    
    // 获取所有关联文章，按发布时间排序
    const relatedPosts = RAW.posts
      .filter(p => isCategory ? p.category === d.id : p.tags.includes(d.id))
      .sort((a, b) => new Date(b.published || 0) - new Date(a.published || 0));
    
    const pageSize = 5;
    const totalPages = Math.ceil(relatedPosts.length / pageSize);
    const displayPosts = relatedPosts.slice((tooltipCurrentPage - 1) * pageSize, tooltipCurrentPage * pageSize);
    
    // 渲染文章列表
    if (relatedPosts.length > 0) {
      tooltipPostsTag.innerHTML = '';
      displayPosts.forEach((post, index) => {
        tooltipPostsTag.innerHTML += `
          <div class="post-item">
            <span class="post-number">${(tooltipCurrentPage - 1) * pageSize + index + 1}</span>
            <a href="${post.url}" target="_blank" class="post-title">${post.title}</a>
          </div>
        `;
      });
      
      // 添加翻页按钮
      if (totalPages > 1) {
        tooltipPostsTag.innerHTML += `
          <div class="tooltip-pagination">
            <span class="pagination-btn prev" ${tooltipCurrentPage <= 1 ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipPrevPage()">‹</span>
            <span class="pagination-info">${tooltipCurrentPage}/${totalPages}</span>
            <span class="pagination-btn next" ${tooltipCurrentPage >= totalPages ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipNextPage()">›</span>
          </div>
        `;
      }
    } else {
      tooltipPostsTag.innerHTML = '<div class="empty-state">暂无关联文章</div>';
    }
    
    // 显示标签卡片
    tooltipTag.classList.remove("hidden");
    
    positionTooltip(event, tooltipTag);
  }
  
  // 定位tooltip
  function positionTooltip(event, tooltipEl) {
    const rect = wrapper.getBoundingClientRect();
    const padding = 16; // 安全边距
    let x = event.clientX - rect.left + 12;
    let y = event.clientY - rect.top - 8;
    const ttRect = tooltipEl.getBoundingClientRect();
    
    // 确保卡片不会超出右侧边界
    if (x + ttRect.width > rect.width - padding) {
      x = rect.width - ttRect.width - padding;
    }
    // 确保卡片不会超出左侧边界
    if (x < padding) {
      x = padding;
    }
    // 确保卡片不会超出底部边界
    if (y + ttRect.height > rect.height - padding) {
      y = rect.height - ttRect.height - padding;
    }
    // 确保卡片不会超出顶部边界
    if (y < padding) {
      y = padding;
    }
    
    tooltipEl.style.left = x + "px";
    tooltipEl.style.top = y + "px";
  }

  function tooltipPrevPage() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    if (tooltipCurrentPage > 1) {
      tooltipCurrentPage--;
      updateTooltipPosts();
    }
  }

  function tooltipNextPage() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    
    // 根据当前视图判断是分类还是标签
    const isCategory = currentView === 'categories' || currentView === 'category-detail';
    const relatedPosts = RAW.posts.filter(p => isCategory ? p.category === tooltipCurrentNode.id : p.tags.includes(tooltipCurrentNode.id));
    
    const totalPages = Math.ceil(relatedPosts.length / 5);
    if (tooltipCurrentPage < totalPages) {
      tooltipCurrentPage++;
      updateTooltipPosts();
    }
  }

  function updateTooltipPosts() {
    if (!tooltipCurrentNode || tooltipCurrentNode.isPost) return;
    
    // 根据当前视图判断是分类还是标签
    const isCategory = currentView === 'categories' || currentView === 'category-detail';
    
    const relatedPosts = RAW.posts
      .filter(p => isCategory ? p.category === tooltipCurrentNode.id : p.tags.includes(tooltipCurrentNode.id))
      .sort((a, b) => new Date(b.published || 0) - new Date(a.published || 0));
    
    const pageSize = 5;
    const totalPages = Math.ceil(relatedPosts.length / pageSize);
    const displayPosts = relatedPosts.slice((tooltipCurrentPage - 1) * pageSize, tooltipCurrentPage * pageSize);
    
    tooltipPostsTag.style.opacity = '0';
    setTimeout(() => {
      tooltipPostsTag.innerHTML = '';
      displayPosts.forEach((post, index) => {
        tooltipPostsTag.innerHTML += `
          <div class="post-item">
            <span class="post-number">${(tooltipCurrentPage - 1) * pageSize + index + 1}</span>
            <a href="${post.url}" target="_blank" class="post-title">${post.title}</a>
          </div>
        `;
      });
      
      // 更新页码
      if (totalPages > 1) {
        tooltipPostsTag.innerHTML += `
          <div class="tooltip-pagination">
            <span class="pagination-btn prev" ${tooltipCurrentPage <= 1 ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipPrevPage()">‹</span>
            <span class="pagination-info">${tooltipCurrentPage}/${totalPages}</span>
            <span class="pagination-btn next" ${tooltipCurrentPage >= totalPages ? 'style="opacity:0.5;cursor:not-allowed;border-color:#b9b9b9;color:#b9b9b9;"' : 'style="cursor:pointer;"'} onclick="tooltipNextPage()">›</span>
          </div>
        `;
      }
      
      tooltipPostsTag.style.opacity = '1';
    }, 100);
  }

  window.tooltipPrevPage = tooltipPrevPage;
  window.tooltipNextPage = tooltipNextPage;

  // 点击按钮切换到标签详情视图
  function switchToTagDetailView(tagId) {
    tooltipTag.classList.add("hidden");
    const tagNode = allTagNodes.find(t => t.id === tagId);
    if (tagNode) {
      switchToPostView(tagNode);
    }
  }

  window.switchToTagDetailView = switchToTagDetailView;
  window.switchToCategoryDetailView = switchToCategoryDetailView;

  // 文章卡片鼠标事件 - 使用mouseover/mouseout确保子元素也能触发
  tooltipPost.addEventListener("mouseover", (e) => {
    // 确保事件来自tooltip本身或其子元素
    if (e.target === tooltipPost || tooltipPost.contains(e.target)) {
      isTooltipHoveredPost = true;
      cancelHideTooltip();
    }
  });

  tooltipPost.addEventListener("mouseout", (e) => {
    // 检查鼠标是否真的离开了tooltip（而不是移动到子元素）
    const relatedTarget = e.relatedTarget;
    if (!tooltipPost.contains(relatedTarget)) {
      isTooltipHoveredPost = false;
      hideTooltip();
    }
  });

  tooltipClosePost.addEventListener("click", (e) => {
    e.stopPropagation();
    tooltipPost.classList.add("hidden");
    tooltipCurrentNode = null;
    tooltipCurrentPage = 1;
    isTooltipHoveredPost = false;
  });

  // 标签卡片鼠标事件
  tooltipTag.addEventListener("mouseover", (e) => {
    if (e.target === tooltipTag || tooltipTag.contains(e.target)) {
      isTooltipHoveredTag = true;
      cancelHideTooltip();
    }
  });

  tooltipTag.addEventListener("mouseout", (e) => {
    const relatedTarget = e.relatedTarget;
    if (!tooltipTag.contains(relatedTarget)) {
      isTooltipHoveredTag = false;
      hideTooltip();
    }
  });

  tooltipCloseTag.addEventListener("click", (e) => {
    e.stopPropagation();
    tooltipTag.classList.add("hidden");
    tooltipCurrentNode = null;
    tooltipCurrentPage = 1;
    isTooltipHoveredTag = false;
  });

  // ========== 搜索 ==========
  const searchInput = document.getElementById("graphSearch");
  const searchBtn = document.getElementById("graphSearchBtn");

  // 视图切换：搜索结果
  function switchToSearchView(keyword) {
    currentView = 'search';
    activeTag = null;
    activeCategory = null;
    backBtn.classList.remove("hidden");
    document.getElementById("toolbarTabs").classList.add("hidden");
    graphTitle.textContent = `搜索「${keyword}」`;

    // 查找匹配的节点（标签和文章）
    const matchedNodes = [];
    const matchedIds = new Set();

    // 匹配标签
    RAW.tags.forEach(tag => {
      if (tag.name.toLowerCase().includes(keyword.toLowerCase())) {
        matchedNodes.push({ ...tag, isTag: true });
        matchedIds.add(tag.id);
      }
    });

    // 匹配文章
    RAW.posts.forEach(post => {
      if (post.title.toLowerCase().includes(keyword.toLowerCase()) ||
          post.description.toLowerCase().includes(keyword.toLowerCase()) ||
          post.tags.some(t => t.toLowerCase().includes(keyword.toLowerCase()))) {
        matchedNodes.push({ ...post });
        matchedIds.add(post.id);
      }
    });

    // 如果没有匹配结果
    if (matchedNodes.length === 0) {
      graphStats.textContent = "未找到匹配内容";
      // 显示空状态
      const nodes = [];
      const links = [];
      const els = renderGraph(nodes, links);
      simulation = createSimulation(nodes, links);
      return;
    }

    graphStats.textContent = `找到 ${matchedNodes.length} 个相关结果`;

    // 构建节点和连线
    const nodes = [];
    const links = [];

    // 添加匹配的节点，按相关性排序后放置在中心附近
    matchedNodes.sort((a, b) => {
      // 标题匹配优先于描述匹配
      const aTitleMatch = a.title?.toLowerCase().includes(keyword.toLowerCase()) ? 1 : 0;
      const bTitleMatch = b.title?.toLowerCase().includes(keyword.toLowerCase()) ? 1 : 0;
      return bTitleMatch - aTitleMatch;
    });

    matchedNodes.forEach((node, i) => {
      const angle = (i / matchedNodes.length) * Math.PI * 2;
      const radiusFactor = Math.sqrt(i / matchedNodes.length);
      const r = radiusFactor * boundaryR * 0.6; // 放在中心附近
      nodes.push({
        ...node,
        radius: node.radius || (node.isPost ? 5 : 10),
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
      });
    });

    // 添加文章和标签之间的关联
    nodes.forEach(node => {
      if (node.isPost && node.tags) {
        node.tags.forEach(tagId => {
          const tagNode = nodes.find(n => n.id === tagId);
          if (tagNode) {
            links.push({
              source: node.id,
              target: tagId,
              strength: 1,
            });
          }
        });
      }
    });

    // 添加标签之间的关联（共享文章的标签）
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        if (!a.isPost && !b.isPost) {
          // 检查是否有共同的文章
          const sharedPosts = RAW.posts.filter(p => 
            p.tags.includes(a.id) && p.tags.includes(b.id)
          );
          if (sharedPosts.length > 0) {
            links.push({
              source: a.id,
              target: b.id,
              strength: sharedPosts.length,
            });
          }
        }
      }
    }

    const els = renderGraph(nodes, links);
    simulation = createSimulation(nodes, links);

    simulation.on("tick", () => {
      tickCount++;
      els.linkSel
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y);
      els.nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
      els.labelSel.attr("x", d => d.x).attr("y", d => d.y);
    });

    simulation.restart();
    
    // 搜索结果放大并聚焦到结果中心
    setTimeout(() => {
      if (nodes.length > 0) {
        // 计算节点边界
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        nodes.forEach(n => {
          const r = n.radius || 8;
          minX = Math.min(minX, n.x - r);
          maxX = Math.max(maxX, n.x + r);
          minY = Math.min(minY, n.y - r);
          maxY = Math.max(maxY, n.y + r);
        });
        const padding = 60;
        const contentW = maxX - minX + padding * 2;
        const contentH = maxY - minY + padding * 2;
        const centerX = (minX + maxX) / 2;
        const centerY = (minY + maxY) / 2;
        const scale = Math.min(1.8, Math.min(width / contentW, height / contentH) * 0.9);
        const tx = width / 2 - centerX * scale;
        const ty = height / 2 - centerY * scale;
        const transform = d3.zoomIdentity.translate(tx, ty).scale(scale);
        svg.transition().duration(500).call(zoom.transform, transform);
        currentZoom = transform;
      }
    }, 100);
    
    resetIdleTimer();
  }

  function doSearch() {
    const kw = searchInput.value.trim();
    if (!kw) {
      // 清空搜索时返回当前视图
      switchView(currentView === 'search' ? 'posts' : currentView);
      return;
    }
    
    // 切换到搜索视图
    switchToSearchView(kw);
  }

  let searchDebounce;
  searchInput.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(doSearch, 250);
  });
  searchBtn.addEventListener("click", doSearch);
  searchInput.addEventListener("keydown", e => { if (e.key === "Enter") doSearch(); });

  // ========== 返回总览 ==========
  backBtn.addEventListener("click", () => {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false).style("display", "");
    document.getElementById("toolbarTabs").classList.remove("hidden");
    // 返回总览时根据当前活动状态切换到对应视图
    if (activeCategory) {
      switchView('categories');
    } else {
      switchView('tags');
    }
  });

  // ========== 重置视图 ==========
  document.getElementById("graphReset").addEventListener("click", () => {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false).style("display", "");
    // 重置到当前选中的tab视图
    if (currentView === 'posts' && activeTag) {
      const tag = allTagNodes.find(t => t.id === activeTag);
      if (tag) switchToPostView(tag);
    } else if (currentView === 'category-detail' && activeCategory) {
      const category = RAW.categories.find(c => c.id === activeCategory);
      if (category) switchToCategoryDetailView(category);
    } else {
      switchView(currentView);
    }
  });

  // ========== resize 防抖 ==========
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      width = wrapper.clientWidth || 800;
      height = wrapper.clientHeight || 500;
      cx = width / 2;
      cy = height / 2;
      boundaryR = Math.min(width, height) * 0.72;
      updateBoundary();
      if (simulation) {
        simulation.force("center", d3.forceCenter(cx, cy).strength(0.035));
        simulation.alpha(0.3).restart();
      }
    }, 150);
  });

  // ========== Tab切换 ==========
  function switchView(viewType) {
    searchInput.value = "";
    d3.selectAll(".graph-node, .graph-link, .graph-label").classed("is-dimmed", false).style("display", "");
    
    // 更新tab状态
    document.querySelectorAll(".tab-item").forEach(el => el.classList.remove("active"));
    document.querySelector(`[data-view="${viewType}"]`)?.classList.add("active");
    
    switch(viewType) {
      case "posts":
        switchToAllPostsView();
        break;
      case "categories":
        switchToCategoryView();
        break;
      case "tags":
        switchToTagView();
        break;
      case "random":
        switchToRandomView();
        break;
    }
  }

  // Tab点击事件
  document.querySelectorAll(".tab-item").forEach(tab => {
    tab.addEventListener("click", () => {
      const viewType = tab.getAttribute("data-view");
      if (viewType) {
        switchView(viewType);
      }
    });
  });

  // ========== 初始化 ==========
  function initGraph() {
    if (hasInitialized) return;
    hasInitialized = true;
    switchView('posts'); // 默认显示全部文章视图
  }

  // 如果 D3 已加载且 wrapper 在视口内，立即初始化
  if (window.d3) {
    const rect = wrapper.getBoundingClientRect();
    const inViewport = rect.top < window.innerHeight && rect.bottom > 0;
    if (inViewport) {
      initGraph();
    } else {
      // 使用 IntersectionObserver 懒加载
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !hasInitialized) {
            initGraph();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(wrapper);
    }
  }

  // ========== 清理函数 ==========
  window.__obsidianGraphCleanup = function() {
    if (simulation) simulation.stop();
    svg.on(".zoom", null);
    clearTimeout(idleTimer);
    clearTimeout(resizeTimer);
    hasInitialized = false;
  };
})();
</script>

<style>
  /* 小球颜色变量 - 固定为 rgb(232, 122, 105) */
  :root {
    --ball-color: rgb(232, 122, 105);
  }
  
  .obsidian-graph {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
  }

  /* 工具栏 */
  .graph-toolbar {
    padding: 1rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.875rem;
  }
  .toolbar-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .graph-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }
  .graph-stats {
    font-size: 0.8125rem;
    color: var(--content-meta);
  }
  .toolbar-center {
    display: none;
  }
  .toolbar-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    margin-top: 0.5rem;
  }
  .toolbar-tabs.hidden {
    display: none;
  }
  .tab-bar {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: color-mix(in srgb, var(--ball-color) 6%, transparent);
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ball-color) 15%, transparent);
  }
  .tab-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border: none;
    background: transparent;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tab-item:hover {
    background: color-mix(in srgb, var(--ball-color) 10%, transparent);
    color: var(--text-primary);
  }
  .tab-item svg {
    flex-shrink: 0;
    vertical-align: middle;
    color: var(--ball-color);
  }
  .tab-item span {
    vertical-align: middle;
    word-break: keep-all;
  }
  .tab-bar.hidden {
    display: none;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .back-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line-color);
    background: var(--card-bg);
    color: var(--ball-color);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .back-btn:hover {
    background: var(--btn-plain-bg-hover);
    border-color: var(--ball-color);
  }
  .back-btn.hidden { display: none; }

.search-box {
    display: flex;
    align-items: center;
    border: 1px solid var(--line-color);
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--card-bg);
    transition: border-color 0.2s, box-shadow 0.2s;
    /* width: 200px; 删掉固定宽 */
