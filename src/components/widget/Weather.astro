---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 模拟天气数据（实际使用时应从 API 获取）
const weatherData = {
	city: "杭州市",
	district: "余杭区",
	temperature: 29,
	condition: "多云",
	highTemp: 33,
	lowTemp: 22,
	wind: "南风",
	windLevel: 3,
	visibility: 14.2,
	feelsLike: 29,
	humidity: 41,
	pressure: 1002,
	airQuality: 50,
	cloudCover: 56,
	uvIndex: 9,
	precipitation: 0,
	precipitationProbability: 0,
	sunrise: "04:58",
	sunset: "19:02",
	pollutants: {
		pm25: 41,
		pm10: 46,
		o3: 50,
	},
};

// 根据天气状况获取图标
const getWeatherIcon = (condition: string): string => {
	const iconMap: Record<string, string> = {
		晴: "mdi:sun",
		晴天: "mdi:sun",
		多云: "mdi:cloud-sun",
		阴: "mdi:cloud",
		阴天: "mdi:cloud",
		小雨: "mdi:cloud-rain",
		中雨: "mdi:cloud-rain",
		大雨: "mdi:cloud-pouring",
		雷阵雨: "mdi:cloud-lightning",
		雪: "mdi:snowflake",
		雾霾: "mdi:cloud-fog",
	};
	return iconMap[condition] || "mdi:cloud";
};

// 获取空气质量等级
const getAirQualityLevel = (aqi: number): { level: string; color: string } => {
	if (aqi <= 50) return { level: "优", color: "#22c55e" };
	if (aqi <= 100) return { level: "良", color: "#84cc16" };
	if (aqi <= 150) return { level: "轻度污染", color: "#eab308" };
	if (aqi <= 200) return { level: "中度污染", color: "#f97316" };
	if (aqi <= 300) return { level: "重度污染", color: "#ef4444" };
	return { level: "严重污染", color: "#991b1b" };
};

const airQualityInfo = getAirQualityLevel(weatherData.airQuality);

const weatherDetails = [
	{
		icon: "mdi:wind",
		label: "风力",
		value: `${weatherData.wind} ${weatherData.windLevel}级`,
	},
	{
		icon: "mdi:eye",
		label: "能见度",
		value: `${weatherData.visibility}km`,
	},
	{
		icon: "mdi:thermometer",
		label: "体感温度",
		value: `${weatherData.feelsLike}°C`,
	},
	{
		icon: "mdi:water",
		label: "湿度",
		value: `${weatherData.humidity}%`,
	},
	{
		icon: "mdi:gauge",
		label: "气压",
		value: `${weatherData.pressure}hPa`,
	},
	{
		icon: "mdi:leaf",
		label: "空气质量",
		value: weatherData.airQuality,
		extra: airQualityInfo.level,
		extraColor: airQualityInfo.color,
	},
	{
		icon: "mdi:cloud",
		label: "云量",
		value: `${weatherData.cloudCover}%`,
	},
	{
		icon: "mdi:sunglasses",
		label: "紫外线",
		value: weatherData.uvIndex.toString(),
	},
	{
		icon: "mdi:cloud-rain",
		label: "降水量",
		value: `${weatherData.precipitation}mm`,
	},
	{
		icon: "mdi:percent",
		label: "降水概率",
		value: `${weatherData.precipitationProbability}%`,
	},
];
---

<WidgetLayout name="天气预报" id="weather" class={className} style={style}>
	<div class="px-4">
		{/* 位置和天气图标 */}
		<div class="flex items-start justify-between mb-4">
			<div class="flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400">
				<Icon name="mdi:map-marker" class="text-sm" />
				<span>{weatherData.city} {weatherData.district}</span>
			</div>
			<div class="text-4xl text-yellow-500">
				<Icon name={getWeatherIcon(weatherData.condition)} />
			</div>
		</div>

		{/* 当前温度和天气状况 */}
		<div class="mb-4">
			<div class="flex items-baseline gap-1">
				<span class="text-5xl font-bold text-neutral-900 dark:text-neutral-100">
					{weatherData.temperature}
				</span>
				<span class="text-2xl text-neutral-600 dark:text-neutral-400">°C</span>
			</div>
			<div class="text-lg text-neutral-700 dark:text-neutral-300 mt-1">
				{weatherData.condition}
			</div>
			<div class="flex gap-4 mt-2 text-sm">
				<span class="text-red-500">高温 {weatherData.highTemp}°C</span>
				<span class="text-blue-500">/ 低温 {weatherData.lowTemp}°C</span>
			</div>
		</div>

		{/* 详细天气信息 */}
		<div class="grid grid-cols-2 gap-2">
			{weatherDetails.map((detail) => (
				<div class="flex items-center gap-2 py-1.5">
					<div class="text-lg text-neutral-500">
						<Icon name={detail.icon} />
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-xs text-neutral-500 dark:text-neutral-400 truncate">
							{detail.label}
						</div>
						<div class="flex items-center gap-1">
							<span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">
								{detail.value}
							</span>
							{detail.extra && (
								<span
									class="text-xs px-1.5 py-0.5 rounded-full"
									style={{ backgroundColor: detail.extraColor, color: "#fff" }}
								>
									{detail.extra}
								</span>
							)}
						</div>
					</div>
				</div>
			))}
		</div>

		{/* 日出日落 */}
		<div class="flex justify-between mt-4 pt-3 border-t border-neutral-200 dark:border-neutral-700">
			<div class="flex items-center gap-2">
				<div class="text-lg text-yellow-500">
					<Icon name="mdi:sunrise" />
				</div>
				<div>
					<div class="text-xs text-neutral-500 dark:text-neutral-400">日出</div>
					<div class="text-sm font-medium text-neutral-700 dark:text-neutral-300">
						{weatherData.sunrise}
					</div>
				</div>
			</div>
			<div class="flex items-center gap-2">
				<div class="text-lg text-orange-500">
					<Icon name="mdi:sunset" />
				</div>
				<div>
					<div class="text-xs text-neutral-500 dark:text-neutral-400">日落</div>
					<div class="text-sm font-medium text-neutral-700 dark:text-neutral-300">
						{weatherData.sunset}
					</div>
				</div>
			</div>
		</div>

		{/* 污染物浓度 */}
		<div class="mt-3 pt-3 border-t border-neutral-200 dark:border-neutral-700">
			<div class="text-xs text-neutral-500 dark:text-neutral-400 mb-2">污染物浓度</div>
			<div class="flex flex-wrap gap-3 text-xs">
				<span>PM2.5: {weatherData.pollutants.pm25}</span>
				<span>PM10: {weatherData.pollutants.pm10}</span>
				<span>O₃: {weatherData.pollutants.o3}</span>
			</div>
		</div>
	</div>
</WidgetLayout>